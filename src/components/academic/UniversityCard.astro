---
import type { University } from '../../types';

interface Props {
  university: University;
  resourceCount?: number;
}

const { university, resourceCount } = Astro.props;

// Generate deterministic initials and colors
const initials = university.name
  .split(' ')
  .map((w) => w[0])
  .filter((c) => /[A-Za-z]/.test(c))
  .slice(0, 3)
  .join('')
  .toUpperCase() || 'UNI';
---

<a
  href={`/university/${university.slug}`}
  class="group relative p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm hover:shadow-xl hover:border-indigo-400 dark:hover:border-indigo-500 transition-all duration-300 flex flex-col justify-between overflow-hidden"
>
  <!-- Background Glow on Hover -->
  <div class="absolute -right-12 -top-12 w-32 h-32 rounded-full bg-indigo-500/10 dark:bg-indigo-400/10 blur-2xl group-hover:scale-150 transition-transform duration-500 pointer-events-none"></div>

  <div>
    <!-- Top Bar: Avatar & Location Badge -->
    <div class="flex items-start justify-between gap-3 mb-4">
      <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-indigo-600 via-indigo-500 to-sky-400 text-white font-extrabold text-lg flex items-center justify-center shadow-md shadow-indigo-600/20 group-hover:scale-105 transition-transform duration-200 shrink-0">
        {initials}
      </div>

      {university.location && (
        <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800/80 px-2.5 py-1 rounded-full border border-slate-200/60 dark:border-slate-800 shrink-0 truncate max-w-[150px]">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="truncate">{university.location.split(',')[0]}</span>
        </span>
      )}
    </div>

    <!-- Title & Description -->
    <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors line-clamp-1">
      {university.name}
    </h3>

    <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 line-clamp-2 leading-relaxed">
      {university.description || 'Access verified study materials, question papers, and student notes for this university.'}
    </p>
  </div>

  <!-- Bottom CTA & Count -->
  <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
    <span class="text-slate-400 font-medium">
      {resourceCount !== undefined ? `${resourceCount} Resources` : 'Student Hub'}
    </span>

    <span class="inline-flex items-center gap-1.5 font-bold text-indigo-600 dark:text-indigo-400 group-hover:translate-x-1 transition-transform">
      <span>Enter Campus Space</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  </div>
</a>
