---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

if (Astro.locals.user) {
  return Astro.redirect('/dashboard');
}

const redirectUrl = Astro.url.searchParams.get('redirect') || '/dashboard';
---

<Layout
  title="Create Student Account | StuddyBuddy"
  description="Register for a free StuddyBuddy student account to upload notes, question papers, and save materials."
  noindex={true}
>
  <Header slot="header" />

  <div class="min-h-[75vh] flex items-center justify-center px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-md w-full p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-xl space-y-6">
      
      <div class="text-center space-y-2">
        <div class="w-12 h-12 mx-auto rounded-2xl bg-gradient-to-tr from-indigo-600 to-sky-400 text-white flex items-center justify-center shadow-md shadow-indigo-600/30">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
          Create Student Account
        </h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Join StuddyBuddy to share past question papers and save study materials.
        </p>
      </div>

      <!-- Success Alert -->
      <div id="success-alert" class="hidden p-3.5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-300 dark:border-emerald-700 text-emerald-800 dark:text-emerald-200 text-xs font-bold flex items-center gap-2.5 shadow-sm">
        <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="success-text">Account ban gaya hai! Dashboard khul raha hai...</span>
      </div>

      <!-- Error Alert -->
      <div id="error-alert" class="hidden p-3.5 rounded-2xl bg-rose-50 dark:bg-rose-950/80 border border-rose-300 dark:border-rose-700 text-rose-800 dark:text-rose-200 text-xs font-semibold flex items-center gap-2.5 shadow-sm">
        <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="error-text">Registration failed.</span>
      </div>

      <form id="register-form" class="space-y-4 text-xs">
        <input type="hidden" name="redirect" value={redirectUrl} />

        <div>
          <label for="displayName" class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">
            Full Name or Display Name <span class="text-rose-500">*</span>
          </label>
          <input
            id="displayName"
            type="text"
            name="displayName"
            required
            placeholder="Aarav Patel"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label for="email" class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">
            Email Address <span class="text-rose-500">*</span>
          </label>
          <input
            id="email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="aarav@paruluniversity.ac.in"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label for="password" class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">
            Password (min. 8 characters) <span class="text-rose-500">*</span>
          </label>
          <input
            id="password"
            type="password"
            name="password"
            required
            minlength="8"
            autocomplete="new-password"
            placeholder="••••••••"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>

        <button
          id="submit-btn"
          type="submit"
          class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md shadow-indigo-600/25 transition-all hover:scale-[1.01] focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
          Create Account
        </button>
      </form>

      <!-- Divider -->
      <div class="relative my-4">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-slate-200 dark:border-slate-800"></div>
        </div>
        <div class="relative flex justify-center text-[10px] uppercase">
          <span class="bg-white dark:bg-slate-900 px-3 text-slate-400 font-bold tracking-wider">Or register with</span>
        </div>
      </div>

      <!-- Google Sign In Button -->
      <button
        id="google-btn"
        type="button"
        class="w-full py-2.5 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700/60 text-slate-700 dark:text-slate-200 font-semibold flex items-center justify-center gap-3 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 text-xs"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
        </svg>
        <span id="google-btn-text">Sign up with Google</span>
      </button>

      <div class="pt-4 border-t border-slate-100 dark:border-slate-800 text-center text-xs text-slate-500 dark:text-slate-400">
        Already have an account?{' '}
        <a href={`/login?redirect=${encodeURIComponent(redirectUrl)}`} class="font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">
          Sign In
        </a>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<script>
  import { signInWithGoogle } from '../lib/firebase';

  const form = document.getElementById('register-form') as HTMLFormElement;
  const alertEl = document.getElementById('error-alert') as HTMLDivElement;
  const errorText = document.getElementById('error-text') as HTMLSpanElement;
  const successEl = document.getElementById('success-alert') as HTMLDivElement;
  const successText = document.getElementById('success-text') as HTMLSpanElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const googleBtn = document.getElementById('google-btn') as HTMLButtonElement;
  const googleBtnText = document.getElementById('google-btn-text') as HTMLSpanElement;

  const urlParams = new URLSearchParams(window.location.search);
  const redirect = urlParams.get('redirect') || '/dashboard';

  // Email / Password Form Submit
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (alertEl) alertEl.classList.add('hidden');
    if (successEl) successEl.classList.add('hidden');
    btn.disabled = true;
    btn.innerText = 'Creating Account... Please wait...';

    const formData = new FormData(form);
    const displayName = formData.get('displayName');
    const email = formData.get('email');
    const password = formData.get('password');

    try {
      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ displayName, email, password }),
      });

      const data = await res.json();
      if (!res.ok) {
        if (errorText) errorText.innerText = data.error || 'Registration failed.';
        if (alertEl) alertEl.classList.remove('hidden');
        btn.disabled = false;
        btn.innerText = 'Create Account';
      } else {
        if (successText) successText.innerText = '✓ Badhai ho! Aapka account ban gaya hai. Dashboard khul raha hai...';
        if (successEl) successEl.classList.remove('hidden');
        btn.innerText = '✓ Account Ban Gaya! Opening Dashboard...';
        setTimeout(() => {
          window.location.href = redirect;
        }, 1200);
      }
    } catch (err: any) {
      if (errorText) errorText.innerText = 'Network error during registration. Please retry.';
      if (alertEl) alertEl.classList.remove('hidden');
      btn.disabled = false;
      btn.innerText = 'Create Account';
    }
  });

  // Google Sign-In with Firebase
  googleBtn?.addEventListener('click', async () => {
    if (alertEl) alertEl.classList.add('hidden');
    if (successEl) successEl.classList.add('hidden');
    googleBtn.disabled = true;
    if (googleBtnText) googleBtnText.innerText = 'Connecting with Google...';

    try {
      const { user, idToken } = await signInWithGoogle();

      const res = await fetch('/api/auth/firebase-login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: user.email,
          displayName: user.displayName,
          photoUrl: user.photoURL,
          uid: user.uid,
          idToken,
        }),
      });

      const data = await res.json();
      if (!res.ok) {
        if (errorText) errorText.innerText = data.error || 'Firebase authentication failed.';
        if (alertEl) alertEl.classList.remove('hidden');
        googleBtn.disabled = false;
        if (googleBtnText) googleBtnText.innerText = 'Sign up with Google';
      } else {
        if (successText) successText.innerText = '✓ Google Sign-in successful! Dashboard khul raha hai...';
        if (successEl) successEl.classList.remove('hidden');
        if (googleBtnText) googleBtnText.innerText = '✓ Connected! Opening Dashboard...';
        setTimeout(() => {
          window.location.href = redirect;
        }, 1200);
      }
    } catch (err: any) {
      console.error('Google Sign-In Error:', err);
      let msg = err?.message || 'Google sign-in was cancelled or failed.';
      if (err?.code === 'auth/operation-not-allowed' || err?.code === 'auth/configuration-not-found') {
        msg = 'Google provider is not enabled in Firebase Console. Please enable it under Authentication > Sign-in method.';
      }
      if (errorText) errorText.innerText = msg;
      if (alertEl) alertEl.classList.remove('hidden');
      googleBtn.disabled = false;
      if (googleBtnText) googleBtnText.innerText = 'Sign up with Google';
    }
  });
</script>
