---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const user = Astro.locals.user;
---

<Layout
  title="Academic PDF Utilities — Merge, Split, Compress & Convert | StuddyBuddy"
  description="Free student document tools: merge lecture slides, split question paper page ranges, compress bulky PDFs, and convert handwritten notes images into PDF."
>
  <Header slot="header" user={user} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16 space-y-10">
    <!-- Header -->
    <div class="text-center space-y-3">
      <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800">
        Student Document Utilities
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Academic PDF & Note Tools
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-xl mx-auto">
        Format and prepare your semester materials. Real, private document processing with immediate downloads.
      </p>
    </div>

    <!-- Tool Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- TOOL 1: Merge PDFs -->
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-4">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/70 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-sm">
          M
        </div>
        <div>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">Merge Multiple PDFs</h2>
          <p class="text-xs text-slate-500 mt-1">Combine separate chapter notes or lecture slides into a single document.</p>
        </div>

        <form action="/api/pdf/process" method="POST" enctype="multipart/form-data" class="space-y-3 text-xs">
          <input type="hidden" name="tool" value="merge" />
          <input
            type="file"
            name="files"
            multiple
            required
            accept="application/pdf"
            class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700"
          />
          <button
            type="submit"
            class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-sm transition-transform hover:scale-[1.01]"
          >
            Merge & Download PDF
          </button>
        </form>
      </div>

      <!-- TOOL 2: Split PDF -->
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-4">
        <div class="w-10 h-10 rounded-xl bg-sky-50 dark:bg-sky-950/70 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold text-sm">
          S
        </div>
        <div>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">Split PDF by Pages</h2>
          <p class="text-xs text-slate-500 mt-1">Extract specific unit pages or exam questions from large textbooks.</p>
        </div>

        <form action="/api/pdf/process" method="POST" enctype="multipart/form-data" class="space-y-3 text-xs">
          <input type="hidden" name="tool" value="split" />
          <input
            type="file"
            name="file"
            required
            accept="application/pdf"
            class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-sky-50 file:text-sky-700"
          />
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block font-medium text-slate-600 dark:text-slate-400 text-[10px] mb-1">Start Page</label>
              <input
                type="number"
                name="startPage"
                value="1"
                min="1"
                required
                class="w-full px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800"
              />
            </div>
            <div>
              <label class="block font-medium text-slate-600 dark:text-slate-400 text-[10px] mb-1">End Page</label>
              <input
                type="number"
                name="endPage"
                value="5"
                min="1"
                required
                class="w-full px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800"
              />
            </div>
          </div>
          <button
            type="submit"
            class="w-full py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-xl shadow-sm transition-transform hover:scale-[1.01]"
          >
            Extract & Download
          </button>
        </form>
      </div>

      <!-- TOOL 3: Images to PDF -->
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-4">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/70 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-sm">
          IMG
        </div>
        <div>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">Convert Images to PDF</h2>
          <p class="text-xs text-slate-500 mt-1">Convert photos of your handwritten notebook pages into a clean PDF document.</p>
        </div>

        <form action="/api/pdf/process" method="POST" enctype="multipart/form-data" class="space-y-3 text-xs">
          <input type="hidden" name="tool" value="image-to-pdf" />
          <input
            type="file"
            name="files"
            multiple
            required
            accept="image/jpeg,image/png"
            class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700"
          />
          <button
            type="submit"
            class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl shadow-sm transition-transform hover:scale-[1.01]"
          >
            Convert Images to PDF
          </button>
        </form>
      </div>

      <!-- TOOL 4: Compress PDF -->
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-4">
        <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-sm">
          ZIP
        </div>
        <div>
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">Optimize & Compress PDF</h2>
          <p class="text-xs text-slate-500 mt-1">Re-encode PDF object streams to reduce file size for easy sharing.</p>
        </div>

        <form action="/api/pdf/process" method="POST" enctype="multipart/form-data" class="space-y-3 text-xs">
          <input type="hidden" name="tool" value="compress" />
          <input
            type="file"
            name="file"
            required
            accept="application/pdf"
            class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-purple-50 file:text-purple-700"
          />
          <button
            type="submit"
            class="w-full py-2.5 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-xl shadow-sm transition-transform hover:scale-[1.01]"
          >
            Compress & Download
          </button>
        </form>
      </div>

    </div>
  </div>

  <Footer slot="footer" />
</Layout>
