        </div>
      )}
    </section>

    <!-- ========================================================== -->
    <!-- SECTION 4: MY CATALOG SUGGESTIONS & ACADEMIC REQUESTS       -->
    <!-- ========================================================== -->
    <section class="space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200 dark:border-slate-800">
        <div>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-xl bg-amber-50 dark:bg-amber-950/70 text-amber-600 dark:text-amber-400 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
              4. My Catalog Suggestions & Requests ({mySuggestions.length})
            </h2>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            Subjects, faculties, or programs you proposed to add to the university catalog.
          </p>
        </div>

        <a
          href="/suggest-catalog"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-900/60 transition-colors shrink-0"
        >
          <span>+ Suggest Missing Subject</span>
        </a>
      </div>

      {mySuggestions.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {mySuggestions.map((sug) => (
            <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-xs space-y-2 shadow-sm">
              <span class="text-[10px] uppercase font-bold text-slate-400">{sug.entityType}</span>
              <h3 class="font-bold text-slate-900 dark:text-white text-sm">{sug.proposedName}</h3>
              <p class="text-slate-500">{sug.parentEntityName || 'Parul University'}</p>
              <div class="pt-2">
                <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-semibold ${
                  sug.status === 'approved' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300' : 
                  sug.status === 'rejected' ? 'bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300' : 
                  'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300'
                }`}>
                  Status: {sug.status.toUpperCase()}
                </span>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="p-6 text-center bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 text-xs text-slate-500">
          No catalog suggestions submitted yet. If you cannot find a subject or course, you can suggest it.
        </div>
      )}
    </section>

    <!-- ========================================================== -->
    <!-- SECTION 4: ACCOUNT SECURITY & CHANGE PASSWORD               -->
    <!-- ========================================================== -->
    <section id="security-section" class="space-y-5 pt-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200 dark:border-slate-800">
        <div>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-xl bg-sky-50 dark:bg-sky-950/70 text-sky-600 dark:text-sky-400 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
              4. Profile Security & Change Password
            </h2>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            Update your account password securely.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-bold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200/50 dark:border-emerald-800/60">
            🔒 Encrypted Security Active
          </span>
        </div>
      </div>

      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm max-w-2xl space-y-5">
        <div id="change-pw-alert" class="hidden p-3.5 rounded-2xl bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-900/60 text-xs text-rose-700 dark:text-rose-300 flex items-start gap-2">
          <span class="font-bold">⚠️</span>
          <span id="change-pw-error-text"></span>
        </div>

        <div id="change-pw-success" class="hidden p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-900/60 text-xs text-emerald-800 dark:text-emerald-300 space-y-1">
          <p class="font-bold flex items-center gap-1.5">
            <span>✓ Password Successfully Updated!</span>
          </p>
          <p class="text-[11px] text-emerald-700 dark:text-emerald-400">
            Your account password has been updated securely. You can now use your new password on your next sign-in.
          </p>
        </div>

        <form id="change-password-form" data-user-email={user.email} class="space-y-4">
          <div>
            <label for="curr-password" class="block font-semibold text-xs text-slate-700 dark:text-slate-300 mb-1">
              Current Password
            </label>
            <input
              id="curr-password"
              type="password"
              required
              autocomplete="current-password"
              placeholder="••••••••"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="new-password" class="block font-semibold text-xs text-slate-700 dark:text-slate-300 mb-1">
                New Password (Min 8 Chars)
              </label>
              <input
                id="new-password"
                type="password"
                required
                minlength="8"
                autocomplete="new-password"
                placeholder="••••••••"
                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500"
              />
            </div>

            <div>
              <label for="confirm-password" class="block font-semibold text-xs text-slate-700 dark:text-slate-300 mb-1">
                Confirm New Password
              </label>
              <input
                id="confirm-password"
                type="password"
                required
                minlength="8"
                autocomplete="new-password"
                placeholder="••••••••"
                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500"
              />
            </div>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <span class="text-[11px] text-slate-400">
              Account: <code class="font-mono text-slate-500 dark:text-slate-400">{user.email}</code>
            </span>
            <button
              id="change-pw-submit-btn"
              type="submit"
              class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-600/20 transition-all hover:scale-[1.01] shrink-0"
            >
              Update Password
            </button>
          </div>
        </form>
      </div>
    </section>

  </div>

  <Footer slot="footer" />
</Layout>

<script is:inline>
  // Handle resource deletion
  document.querySelectorAll('.delete-res-btn').forEach((button) => {
    button.addEventListener('click', async () => {
      const resId = button.getAttribute('data-resource-id');
      const resTitle = button.getAttribute('data-resource-title') || 'this material';

      if (!confirm(`Are you sure you want to delete "${resTitle}"? This action cannot be undone.`)) {
        return;
      }

      button.disabled = true;
      button.innerText = 'Deleting...';

      try {
        const res = await fetch(`/api/resources/${resId}`, {
          method: 'DELETE',
        });

        const data = await res.json();
        const toast = document.getElementById('delete-toast');

        if (!res.ok) {
          alert(data.error || 'Failed to delete resource.');
          button.disabled = false;
          button.innerText = 'Delete';
        } else {
          // Remove row from table
          const row = document.getElementById(`row-${resId}`);
          if (row) {
            row.style.transition = 'all 0.3s ease';
            row.style.opacity = '0';
            setTimeout(() => row.remove(), 300);
          }
          if (toast) {
            toast.innerText = '✓ Resource deleted successfully.';
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 4000);
          }
        }
      } catch (err) {
        alert('Network error trying to delete resource.');
        button.disabled = false;
        button.innerText = 'Delete';
      }
    });
  });
</script>

<script>
  import { changeFirebasePassword } from '../lib/firebase';

  const form = document.getElementById('change-password-form') as HTMLFormElement;
  const userEmail = form?.dataset.userEmail || '';
  const currPassInput = document.getElementById('curr-password') as HTMLInputElement;
  const newPassInput = document.getElementById('new-password') as HTMLInputElement;
  const confirmPassInput = document.getElementById('confirm-password') as HTMLInputElement;
  const alertEl = document.getElementById('change-pw-alert');
  const errorText = document.getElementById('change-pw-error-text');
  const successEl = document.getElementById('change-pw-success');
  const submitBtn = document.getElementById('change-pw-submit-btn') as HTMLButtonElement;

  // Quick jump from hero card "Change Password" button
  document.getElementById('profile-change-pw-btn')?.addEventListener('click', () => {
    const sec = document.getElementById('security-section');
    if (sec) {
      sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      currPassInput?.focus();
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (alertEl) alertEl.classList.add('hidden');
    if (successEl) successEl.classList.add('hidden');

    const currentPassword = currPassInput.value;
    const newPassword = newPassInput.value;
    const confirmPassword = confirmPassInput.value;

    if (newPassword.length < 8) {
      if (errorText) errorText.innerText = 'New password must be at least 8 characters long.';
      if (alertEl) alertEl.classList.remove('hidden');
      newPassInput.focus();
      return;
    }

    if (newPassword !== confirmPassword) {
      if (errorText) errorText.innerText = 'New password and confirm password do not match.';
      if (alertEl) alertEl.classList.remove('hidden');
      confirmPassInput.focus();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerText = 'Updating Password...';

    try {
      // 1. Update password using Firebase Authentication
      await changeFirebasePassword(userEmail, currentPassword, newPassword);

      // 2. Synchronize password in backend store / database
      const res = await fetch('/api/auth/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ currentPassword, newPassword }),
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || 'Failed to update database password.');
      }

      if (successEl) successEl.classList.remove('hidden');
      form.reset();
      submitBtn.innerText = '✓ Password Changed!';
      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.innerText = 'Update Password';
      }, 3500);
    } catch (err: any) {
      console.error('Password change error:', err);
      let msg = err?.message || 'Failed to update password. Please check your current password and try again.';
      if (msg.includes('auth/wrong-password') || msg.includes('auth/invalid-credential')) {
        msg = 'Current password is incorrect. Please enter your valid current password.';
      }
      if (errorText) errorText.innerText = msg;
      if (alertEl) alertEl.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.innerText = 'Update Password';
    }
  });
</script>
