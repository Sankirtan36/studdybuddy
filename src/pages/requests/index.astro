---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { searchResourceRequests } from '../../server/repositories/requestRepository';

const user = Astro.locals.user;
const statusFilter = Astro.url.searchParams.get('status') || '';
const programFilter = Astro.url.searchParams.get('programId') || '';

const { requests, total } = await searchResourceRequests({
  status: statusFilter || undefined,
  programId: programFilter || undefined,
  limit: 30,
});

const openCount = requests.filter((r) => r.status === 'open').length;
const fulfilledCount = requests.filter((r) => r.status === 'fulfilled').length;
---

<Layout
  title="Student Resource Requests | StuddyBuddy"
  description="Request missing previous year question papers, notes, or solutions from peer students across Parul University curricula."
>
  <Header slot="header" user={user} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16 space-y-10">
    
    <!-- Hero Banner -->
    <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-slate-200/80 dark:border-slate-800 gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800 mb-2">
          <span>Peer-to-Peer Study Material Exchange</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Student Resource Requests
        </h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 max-w-2xl">
          Can't find a past exam paper or lecture notes? Post a request here. Students who fulfill your request earn <strong class="text-indigo-600 dark:text-indigo-400 font-bold">+25 reputation points</strong>!
        </p>
      </div>

      <button
        id="open-request-modal-btn"
        type="button"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-md shadow-indigo-600/25 transition-all hover:scale-[1.02]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Request Material</span>
      </button>
    </div>

    <!-- Stats & Filters Toolbar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm text-xs">
      <div class="flex flex-wrap items-center gap-2">
        <a
          href="/requests"
          class={`px-3.5 py-1.5 rounded-xl font-semibold transition-all ${
            !statusFilter ? 'bg-indigo-600 text-white' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300'
          }`}
        >
          All ({total})
        </a>
        <a
          href="/requests?status=open"
          class={`px-3.5 py-1.5 rounded-xl font-semibold transition-all ${
            statusFilter === 'open' ? 'bg-indigo-600 text-white' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300'
          }`}
        >
          Open ({openCount})
        </a>
        <a
          href="/requests?status=fulfilled"
          class={`px-3.5 py-1.5 rounded-xl font-semibold transition-all ${
            statusFilter === 'fulfilled' ? 'bg-indigo-600 text-white' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300'
          }`}
        >
          Fulfilled ({fulfilledCount})
        </a>
      </div>

      <div class="flex items-center gap-2 text-slate-500">
        <span>Helping peers advances your campus badge & unlocks verified perks</span>
      </div>
    </div>

    <!-- Requests Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {requests.length > 0 ? (
        requests.map((req) => (
          <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col justify-between space-y-4 hover:shadow-md transition-shadow">
            <div class="space-y-3">
              <!-- Top Row Badges -->
              <div class="flex items-center justify-between gap-2">
                <span class={`px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                  req.status === 'fulfilled'
                    ? 'bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200'
                    : 'bg-amber-50 dark:bg-amber-950/70 text-amber-700 dark:text-amber-300 border border-amber-200'
                }`}>
                  {req.status === 'fulfilled' ? '✓ Fulfilled' : '• Open Request'}
                </span>

                <span class={`px-2 py-0.5 rounded-lg text-[10px] font-semibold ${
                  req.urgency === 'urgent'
                    ? 'bg-rose-50 text-rose-700 dark:bg-rose-950/70 dark:text-rose-300 border border-rose-200'
                    : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400'
                }`}>
                  {req.urgency.toUpperCase()}
                </span>
              </div>

              <!-- Subject & Category -->
              <div>
                <span class="text-[11px] font-semibold text-indigo-600 dark:text-indigo-400 block uppercase tracking-wider">
                  {req.category}
                </span>
                <h2 class="text-lg font-bold text-slate-900 dark:text-white leading-snug">
                  {req.subjectName}
                </h2>
                {req.examYear && (
                  <p class="text-xs text-slate-500 mt-0.5">Exam Year: {req.examYear}</p>
                )}
              </div>

              {req.description && (
                <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2">
                  "{req.description}"
                </p>
              )}
            </div>

            <!-- Bottom Row: Requester Info & Actions -->
            <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs">
              <div>
                <span class="block text-[10px] text-slate-400 uppercase">Requested By</span>
                <span class="font-semibold text-slate-800 dark:text-slate-200">{req.requesterName}</span>
              </div>

              {req.status === 'open' ? (
                <a
                  href={`/upload?subjectName=${encodeURIComponent(req.subjectName)}&subjectId=${encodeURIComponent(req.subjectId)}&category=${encodeURIComponent(req.category)}&requestId=${encodeURIComponent(req._id?.toString() || '')}`}
                  class="px-3.5 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-600 hover:text-white text-indigo-600 dark:bg-indigo-950/80 dark:text-indigo-300 dark:hover:bg-indigo-600 dark:hover:text-white font-bold transition-colors"
                >
                  I Have This (+25 pts)
                </a>
              ) : req.fulfilledResourceId ? (
                <a
                  href={`/resources/${req.fulfilledResourceId}`}
                  class="px-3.5 py-1.5 rounded-xl bg-emerald-50 hover:bg-emerald-600 hover:text-white text-emerald-700 dark:bg-emerald-950/80 dark:text-emerald-300 font-bold transition-colors"
                >
                  View Solution →
                </a>
              ) : null}
            </div>
          </div>
        ))
      ) : (
        <div class="col-span-full p-16 text-center bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 space-y-4">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-indigo-50 dark:bg-indigo-950/70 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h2 class="text-lg font-bold text-slate-800 dark:text-slate-200">No Resource Requests Found</h2>
          <p class="text-xs text-slate-500 max-w-sm mx-auto">
            All study materials are currently fulfilled or none have been requested yet for this filter.
          </p>
        </div>
      )}
    </div>
  </div>

  <!-- Create Request Modal -->
  <div id="request-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
    <div class="max-w-md w-full p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-2xl space-y-5">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Request Study Material</h2>
        <button id="close-modal-btn" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-lg">✕</button>
      </div>

      <form id="create-request-form" class="space-y-4 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Subject Name *</label>
          <input
            type="text"
            name="subjectName"
            required
            placeholder="e.g. Data Structures & Algorithms, Pharma Chem"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Category</label>
            <select
              name="category"
              class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            >
              <option value="Previous Year Question Paper">Previous Year Paper</option>
              <option value="Mid-Semester Paper">Mid-Sem Paper</option>
              <option value="End-Semester Paper">End-Sem Paper</option>
              <option value="Notes">Lecture Notes</option>
              <option value="Assignment Solution">Assignment Solution</option>
            </select>
          </div>

          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Exam Year</label>
            <input
              type="number"
              name="examYear"
              placeholder="e.g. 2024"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Urgency</label>
          <select
            name="urgency"
            class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          >
            <option value="normal">Normal</option>
            <option value="urgent">Urgent (Exam within 48h)</option>
            <option value="low">Low Priority</option>
          </select>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Specific Details (Optional)</label>
          <textarea
            name="description"
            rows="2"
            placeholder="e.g. Looking for Unit 3 questions with numerical solutions"
            class="w-full px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          ></textarea>
        </div>

        <button
          type="submit"
          id="submit-request-btn"
          class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md shadow-indigo-600/25 transition-all"
        >
          Post Request
        </button>
      </form>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<script>
  const openModalBtn = document.getElementById('open-request-modal-btn');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const modal = document.getElementById('request-modal');
  const form = document.getElementById('create-request-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-request-btn') as HTMLButtonElement;

  openModalBtn?.addEventListener('click', () => {
    modal?.classList.remove('hidden');
  });

  closeModalBtn?.addEventListener('click', () => {
    modal?.classList.add('hidden');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerText = 'Posting request...';
    }

    const formData = new FormData(form);
    const subjectName = formData.get('subjectName')?.toString().trim();
    const category = formData.get('category')?.toString().trim();
    const examYearStr = formData.get('examYear')?.toString().trim();
    const urgency = formData.get('urgency')?.toString().trim() || 'normal';
    const description = formData.get('description')?.toString().trim();

    const subjectId = (subjectName || 'general').toLowerCase().replace(/[^a-z0-9]/g, '-');
    const examYear = examYearStr ? parseInt(examYearStr, 10) : undefined;

    try {
      const res = await fetch('/api/requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          subjectId,
          subjectName,
          category,
          examYear,
          urgency,
          description,
        }),
      });

      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'Failed to submit request');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Post Request';
        }
      } else {
        alert('Request posted successfully!');
        window.location.reload();
      }
    } catch {
      alert('Network error. Please try again.');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerText = 'Post Request';
      }
    }
  });
</script>

