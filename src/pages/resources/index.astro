---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ResourceCard from '../../components/resources/ResourceCard.astro';
import { searchResources } from '../../server/repositories/resourceRepository';
import type { ResourceCategory, SupportedFileExtension } from '../../types';

// Read query params
const search = Astro.url.searchParams.get('search') || '';
const category = (Astro.url.searchParams.get('category') as ResourceCategory) || undefined;
const fileExt = (Astro.url.searchParams.get('fileExtension') as SupportedFileExtension) || undefined;
const programId = Astro.url.searchParams.get('programId') || undefined;
const sortBy = (Astro.url.searchParams.get('sortBy') as 'newest' | 'downloads' | 'views') || 'newest';
const page = parseInt(Astro.url.searchParams.get('page') || '1', 10);

const results = await searchResources({
  search,
  category,
  fileExtension: fileExt,
  programId,
  sortBy,
  page,
  limit: 12,
});

const categories = [
  'Previous Year Question Paper',
  'Mid-Semester Paper',
  'End-Semester Paper',
  'Notes',
  'Question Bank',
  'Assignment',
  'Assignment Solution',
  'Solved Paper',
  'Practical & Lab Material',
  'Presentation/PPT',
];

const fileTypes = ['pdf', 'pptx', 'docx', 'jpg', 'png'];

function buildFilterUrl(newParams: Record<string, string | undefined>) {
  const current = new URLSearchParams(Astro.url.search);
  for (const [key, val] of Object.entries(newParams)) {
    if (val === undefined || val === '') {
      current.delete(key);
    } else {
      current.set(key, val);
    }
  }
  // Reset page to 1 on filter change
  if (!('page' in newParams)) {
    current.set('page', '1');
  }
  return `/resources?${current.toString()}`;
}
---

<Layout
  title="Browse Academic Resources & Papers | StuddyBuddy"
  description="Search and filter previous year question papers, handwritten lecture notes, question banks, and syllabus across universities and semesters."
>
  <Header slot="header" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Header Title Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-200/80 dark:border-slate-800">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Browse Academic Resources
        </h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
          Showing {results.total} approved resource{results.total === 1 ? '' : 's'} across university curricula.
        </p>
      </div>

      <!-- Sorting Selector -->
      <div class="flex items-center gap-3">
        <label for="sort-select" class="text-xs font-semibold uppercase tracking-wider text-slate-500">Sort By:</label>
        <select
          id="sort-select"
          class="text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3 py-2 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          onchange="location.href = this.value"
        >
          <option value={buildFilterUrl({ sortBy: 'newest' })} selected={sortBy === 'newest'}>Recently Added</option>
          <option value={buildFilterUrl({ sortBy: 'downloads' })} selected={sortBy === 'downloads'}>Most Downloaded</option>
          <option value={buildFilterUrl({ sortBy: 'views' })} selected={sortBy === 'views'}>Most Viewed</option>
        </select>
      </div>
    </div>

    <!-- Main Content Area: Sidebar Filters + Cards Grid -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- Filters Sidebar -->
      <aside class="space-y-6">
        <!-- Search Input -->
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">Keywords Search</h2>
          <form action="/resources" method="GET" class="space-y-2">
            {category && <input type="hidden" name="category" value={category} />}
            {fileExt && <input type="hidden" name="fileExtension" value={fileExt} />}
            {programId && <input type="hidden" name="programId" value={programId} />}
            {sortBy && <input type="hidden" name="sortBy" value={sortBy} />}

            <div class="relative">
              <input
                type="text"
                name="search"
                value={search}
                placeholder="Topic, subject, code..."
                class="w-full px-3 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
              />
            </div>
            <button
              type="submit"
              class="w-full py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-xl shadow-sm transition-colors"
            >
              Filter Keywords
            </button>
          </form>
        </div>

        <!-- Category Filters -->
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">Resource Category</h2>
            {category && (
              <a href={buildFilterUrl({ category: undefined })} class="text-[11px] text-indigo-600 dark:text-indigo-400 hover:underline">
                Clear
              </a>
            )}
          </div>

          <div class="space-y-1.5 text-sm">
            <a
              href={buildFilterUrl({ category: undefined })}
              class={`block px-2.5 py-1.5 rounded-lg transition-colors ${
                !category ? 'bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 font-semibold' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'
              }`}
            >
              All Categories
            </a>
            {categories.map((cat) => (
              <a
                href={buildFilterUrl({ category: cat })}
                class={`block px-2.5 py-1.5 rounded-lg transition-colors text-xs ${
                  category === cat
                    ? 'bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 font-semibold'
                    : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800'
                }`}
              >
                {cat}
              </a>
            ))}
          </div>
        </div>

        <!-- File Format Filters -->
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">File Format</h2>
            {fileExt && (
              <a href={buildFilterUrl({ fileExtension: undefined })} class="text-[11px] text-indigo-600 dark:text-indigo-400 hover:underline">
                Clear
              </a>
            )}
          </div>

          <div class="flex flex-wrap gap-1.5">
            {fileTypes.map((ext) => (
              <a
                href={buildFilterUrl({ fileExtension: fileExt === ext ? undefined : ext })}
                class={`px-3 py-1 rounded-lg text-xs font-medium uppercase transition-colors ${
                  fileExt === ext
                    ? 'bg-indigo-600 text-white'
                    : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700'
                }`}
              >
                {ext}
              </a>
            ))}
          </div>
        </div>

        <!-- Clear All Filters Button -->
        {(search || category || fileExt || programId) && (
          <a
            href="/resources"
            class="block w-full py-2.5 text-center text-xs font-semibold text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/50 hover:bg-rose-100 rounded-xl transition-colors border border-rose-200 dark:border-rose-900/60"
          >
            Reset All Filters
          </a>
        )}
      </aside>

      <!-- Resource Grid -->
      <section class="lg:col-span-3">
        {results.resources.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {results.resources.map((resource) => (
              <ResourceCard resource={resource} />
            ))}
          </div>
        ) : (
          <div class="p-12 text-center rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-500 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">No Matching Resources Found</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto leading-relaxed">
              We couldn't find any approved study materials matching your selected filters. Try broadening your keywords or removing specific filters.
            </p>
            <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
              <a
                href="/resources"
                class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200"
              >
                Reset Filters
              </a>
              <a
                href="/upload"
                class="px-4 py-2 rounded-xl text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm"
              >
                Upload This Resource
              </a>
              <a
                href="/suggest-catalog"
                class="px-4 py-2 rounded-xl text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline"
              >
                Suggest Missing Subject
              </a>
            </div>
          </div>
        )}

        <!-- Pagination Controls -->
        {results.totalPages > 1 && (
          <div class="mt-12 flex items-center justify-between border-t border-slate-200 dark:border-slate-800 pt-6">
            <a
              href={results.page > 1 ? buildFilterUrl({ page: String(results.page - 1) }) : '#'}
              class={`px-4 py-2 text-xs font-semibold rounded-xl border border-slate-200 dark:border-slate-800 ${
                results.page > 1 ? 'hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200' : 'opacity-40 cursor-not-allowed text-slate-400'
              }`}
            >
              ← Previous
            </a>

            <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
              Page {results.page} of {results.totalPages}
            </span>

            <a
              href={results.page < results.totalPages ? buildFilterUrl({ page: String(results.page + 1) }) : '#'}
              class={`px-4 py-2 text-xs font-semibold rounded-xl border border-slate-200 dark:border-slate-800 ${
                results.page < results.totalPages ? 'hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200' : 'opacity-40 cursor-not-allowed text-slate-400'
              }`}
            >
              Next →
            </a>
          </div>
        )}
      </section>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>
