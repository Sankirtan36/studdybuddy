---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ResourceCard from '../../components/resources/ResourceCard.astro';
import { getResourceById, incrementResourceView, searchResources } from '../../server/repositories/resourceRepository';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/resources');
}

const resource = await getResourceById(id);

// Only approved resources are publicly visible
if (!resource || resource.status !== 'approved') {
  return new Response('Resource Not Found or Pending Moderation', { status: 404 });
}

// Increment view count asynchronously
await incrementResourceView(id);

// Fetch related resources in the same program or subject
const relatedRes = await searchResources({
  status: 'approved',
  programId: resource.programId,
  limit: 3,
});

const relatedResources = relatedRes.resources.filter((r) => r._id?.toString() !== id);

function formatBytes(bytes: number) {
  if (!bytes) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
}

const resourceUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;
---

<Layout
  title={`${resource.title} | StuddyBuddy`}
  description={resource.description || `Download ${resource.title} (${resource.category}) for university exams on StuddyBuddy.`}
  canonical={resourceUrl}
>
  <Header slot="header" user={Astro.locals.user} />

  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Home</a>
      <span>/</span>
      <a href="/resources" class="hover:text-indigo-600 dark:hover:text-indigo-400">Resources</a>
      <span>/</span>
      <a href={`/university/parul-university`} class="hover:text-indigo-600 dark:hover:text-indigo-400">Parul University</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-medium truncate max-w-xs">{resource.title}</span>
    </nav>

    <!-- Main Resource Hero Card -->
    <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-6">
      <!-- Category Badge & File Format -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 dark:bg-indigo-950/70 dark:text-indigo-300 border border-indigo-200/80 dark:border-indigo-800">
          {resource.category}
        </span>

        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-lg">
          <svg class="w-4 h-4 text-indigo-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
          </svg>
          {(resource.fileExtension || 'PDF').toUpperCase()} • {formatBytes(resource.fileSizeBytes)}
        </span>
      </div>

      <!-- Title -->
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white leading-tight">
        {resource.title}
      </h1>

      <!-- Metadata Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 text-xs">
        <div>
          <span class="block text-slate-400 font-medium uppercase text-[10px]">Institution</span>
          <span class="font-semibold text-slate-800 dark:text-slate-200">Parul University</span>
        </div>
        <div>
          <span class="block text-slate-400 font-medium uppercase text-[10px]">Exam Session</span>
          <span class="font-semibold text-slate-800 dark:text-slate-200">
            {resource.examYear ? `${resource.examYear} ${resource.examSession || ''}` : 'Not specified'}
          </span>
        </div>
        <div>
          <span class="block text-slate-400 font-medium uppercase text-[10px]">Total Views</span>
          <span class="font-semibold text-slate-800 dark:text-slate-200">{resource.viewCount} views</span>
        </div>
        <div>
          <span class="block text-slate-400 font-medium uppercase text-[10px]">Downloads</span>
          <span class="font-semibold text-emerald-600 dark:text-emerald-400 font-bold">{resource.downloadCount} downloads</span>
        </div>
      </div>

      <!-- Description -->
      {resource.description && (
        <div class="space-y-2">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">Description & Syllabus Coverage</h2>
          <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-300">
            {resource.description}
          </p>
        </div>
      )}

      <!-- Contributor Attribution -->
      <div class="flex items-center gap-3 pt-2">
        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-indigo-500 to-sky-400 flex items-center justify-center text-white font-bold text-sm">
          {resource.contributorName.charAt(0)}
        </div>
        <div>
          <span class="block text-[11px] text-slate-400">Contributed by</span>
          <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">{resource.contributorName}</span>
        </div>
      </div>

      <!-- Action Buttons: Download & Save -->
      <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center gap-3">
        <a
          href={`/api/resources/${id}/download`}
          download={resource.originalFilename || `${resource.title}.${resource.fileExtension || 'pdf'}`}
          class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-md shadow-indigo-600/25 transition-all hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Download ({resource.originalFilename || `${resource.title}.pdf`})</span>
        </a>

        <a
          href={`/api/resources/${id}/preview`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-3.5 rounded-xl border border-indigo-200 dark:border-indigo-800 hover:bg-indigo-50 dark:hover:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 text-sm font-semibold transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <span>Open in Browser</span>
        </a>

        <button
          type="button"
          onclick={`alert('To bookmark resources, please sign in or register an account.')`}
          class="inline-flex items-center justify-center gap-1.5 px-4 py-3.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 text-sm font-semibold transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
          <span>Save to My Library</span>
        </button>

        <!-- Report Button -->
        <a
          href={`/contact?reportResourceId=${id}`}
          class="ml-auto inline-flex items-center gap-1 text-xs text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 transition-colors py-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span>Report Content / DMCA</span>
        </a>
      </div>
    </div>

    <!-- Related Resources Section -->
    {relatedResources.length > 0 && (
      <section class="mt-12 space-y-6">
        <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
          Related Resources in This Program
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedResources.map((rel) => (
            <ResourceCard resource={rel} />
          ))}
        </div>
      </section>
    )}
  </article>

  <!-- JSON-LD Structured Data for SEO -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'DigitalDocument',
    'name': resource.title,
    'description': resource.description || resource.title,
    'encodingFormat': resource.mimeType,
    'author': {
      '@type': 'Person',
      'name': resource.contributorName,
    },
    'datePublished': new Date(resource.createdAt).toISOString(),
  })} />

  <Footer slot="footer" />
</Layout>
