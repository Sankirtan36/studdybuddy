---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

// If already logged in, redirect to dashboard or admin
if (Astro.locals.user) {
  if (Astro.locals.user.role === 'admin' || Astro.locals.user.role === 'owner') {
    return Astro.redirect('/admin');
  }
  return Astro.redirect('/dashboard');
}

const redirectUrl = Astro.url.searchParams.get('redirect') || '/dashboard';
const urlError = Astro.url.searchParams.get('error') || '';
const prefillEmail = Astro.url.searchParams.get('email') || '';
---

<Layout
  title="Sign In to StuddyBuddy | Academic Resource Platform"
  description="Sign in to your StuddyBuddy account to upload academic materials, manage contributions, and save resources."
  noindex={true}
>
  <Header slot="header" />

  <div class="min-h-[75vh] flex items-center justify-center px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-md w-full p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-xl space-y-6">
      
      <!-- Heading -->
      <div class="text-center space-y-2">
        <div class="w-12 h-12 mx-auto rounded-2xl bg-indigo-600 text-white flex items-center justify-center shadow-md shadow-indigo-600/30">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
          Welcome to StuddyBuddy
        </h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Sign in to contribute lecture notes, question papers, and save materials.
        </p>
      </div>

      <!-- Success Alert Box -->
      <div id="success-alert" class="hidden p-3.5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-300 dark:border-emerald-700 text-emerald-800 dark:text-emerald-200 text-xs font-bold flex items-center gap-2.5 shadow-sm">
        <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="success-text">Login successful! Redirecting to your dashboard...</span>
      </div>

      <!-- Error Alert Box -->
      <div id="error-alert" class={`${urlError ? '' : 'hidden'} p-3.5 rounded-2xl bg-rose-50 dark:bg-rose-950/80 border border-rose-300 dark:border-rose-700 text-rose-800 dark:text-rose-200 text-xs font-semibold flex items-center gap-2.5 shadow-sm`}>
        <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="error-text">{urlError || 'Failed to sign in. Please check credentials.'}</span>
      </div>

      <!-- Login Form -->
      <form id="login-form" action="/api/auth/login" method="POST" target="_self" class="space-y-4 text-xs">
        <input type="hidden" name="redirect" value={redirectUrl} />

        <div>
          <label for="email" class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">
            Email Address
          </label>
          <input
            id="email"
            type="email"
            name="email"
            value={prefillEmail}
            required
            autocomplete="email"
            placeholder="student@paruluniversity.ac.in"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="password" class="block font-semibold text-slate-700 dark:text-slate-300">
              Password
            </label>
            <button
              id="forgot-password-link"
              type="button"
              class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 hover:underline transition-colors focus:outline-none"
            >
              Forgot password?
            </button>
          </div>
          <input
            id="password"
            type="password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>

        <button
          id="submit-btn"
          type="submit"
          class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md shadow-indigo-600/25 transition-all hover:scale-[1.01] focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
          Sign In
        </button>
      </form>

      <!-- Divider -->
      <div class="relative my-4">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-slate-200 dark:border-slate-800"></div>
        </div>
        <div class="relative flex justify-center text-[10px] uppercase">
          <span class="bg-white dark:bg-slate-900 px-3 text-slate-400 font-bold tracking-wider">Or continue with</span>
        </div>
      </div>

      <!-- Google Sign In Button -->
      <button
        id="google-btn"
        type="button"
        class="w-full py-2.5 px-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700/60 text-slate-700 dark:text-slate-200 font-semibold flex items-center justify-center gap-3 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 text-xs"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
        </svg>
        <span id="google-btn-text">Sign in with Google</span>
      </button>

      <!-- Bottom link -->
      <div class="pt-4 border-t border-slate-100 dark:border-slate-800 text-center text-xs text-slate-500 dark:text-slate-400">
        Don't have an account yet?{' '}
        <a href={`/register?redirect=${encodeURIComponent(redirectUrl)}`} class="font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">
          Create student account
        </a>
      </div>
    </div>
  </div>

  <!-- Forgot Password Modal -->
  <div
    id="forgot-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200"
  >
    <div
      class="w-full max-w-md bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-7 shadow-2xl space-y-5 transform scale-95 transition-transform duration-200"
      id="forgot-modal-box"
    >
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/70 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">Reset Password</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Secure Account Recovery</p>
          </div>
        </div>
        <button
          id="close-forgot-modal"
          type="button"
          class="w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          aria-label="Close"
        >
          ✕
        </button>
      </div>

      <div
        id="forgot-alert"
        class="hidden p-3.5 rounded-xl bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-900/60 text-xs text-rose-700 dark:text-rose-300 flex items-start gap-2"
      >
        <span class="font-bold">⚠️</span>
        <span id="forgot-error-text"></span>
      </div>

      <div
        id="forgot-success"
        class="hidden p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-900/60 text-xs text-emerald-800 dark:text-emerald-300 space-y-1.5"
      >
        <p class="font-bold flex items-center gap-1.5">
          <span>✓ Reset Link Sent Successfully!</span>
        </p>
        <p class="text-[11px] text-emerald-700 dark:text-emerald-400 leading-relaxed">
          We have dispatched a password reset link to your email address. Please check your inbox and spam folder.
        </p>
      </div>

      <form id="forgot-form" class="space-y-4">
        <div>
          <label for="forgot-email" class="block font-semibold text-xs text-slate-700 dark:text-slate-300 mb-1">
            Registered Email Address
          </label>
          <input
            id="forgot-email"
            type="email"
            required
            autocomplete="email"
            placeholder="student@paruluniversity.ac.in"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>

        <p class="text-[11px] text-slate-400 leading-relaxed">
          Our identity security service generates an encrypted reset token and delivers an official reset email to verify your account ownership.
        </p>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button
            id="cancel-forgot-btn"
            type="button"
            class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          >
            Cancel
          </button>
          <button
            id="forgot-submit-btn"
            type="submit"
            class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-600/20 transition-all hover:scale-[1.01]"
          >
            Send Reset Link
          </button>
        </div>
      </form>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<script>
  import { signInWithGoogle, signInWithGoogleRedirect, checkGoogleRedirectResult, sendPasswordReset } from '../lib/firebase';

  function initLogin() {
    const form = document.getElementById('login-form') as HTMLFormElement | null;
    const alertEl = document.getElementById('error-alert') as HTMLDivElement | null;
    const errorText = document.getElementById('error-text') as HTMLSpanElement | null;
    const successEl = document.getElementById('success-alert') as HTMLDivElement | null;
    const successText = document.getElementById('success-text') as HTMLSpanElement | null;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const googleBtn = document.getElementById('google-btn') as HTMLButtonElement | null;
    const googleBtnText = document.getElementById('google-btn-text') as HTMLSpanElement | null;

    const urlParams = new URLSearchParams(window.location.search);
    const redirect = urlParams.get('redirect') || '/dashboard';

    // Prevent re-attaching duplicate listeners
    if (form && (form as any)._initialized) return;
    if (form) (form as any)._initialized = true;

    // Check if returning from Google Redirect Auth
    try {
      checkGoogleRedirectResult().then(async (result) => {
        if (result && result.user) {
          if (googleBtn) googleBtn.disabled = true;
          if (googleBtnText) googleBtnText.innerText = 'Finishing Google sign-in...';
          try {
            const res = await fetch('/api/auth/firebase-login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({
                email: result.user.email,
                displayName: result.user.displayName,
                photoUrl: result.user.photoURL,
                uid: result.user.uid,
                idToken: result.idToken,
              }),
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok) {
              const isStaff = data.user?.role === 'admin' || data.user?.role === 'owner';
              const destination = isStaff ? '/admin' : (data.redirect || redirect);
              if (successText) successText.innerText = `✓ Google Sign-in successful! Welcome, ${result.user.displayName || (isStaff ? 'Administrator' : 'Student')}! Opening ${isStaff ? 'Admin Control Center' : 'dashboard'}...`;
              if (successEl) successEl.classList.remove('hidden');
              window.location.href = destination;
            } else {
              if (errorText) errorText.innerText = data.error || 'Authentication failed. Please verify your credentials.';
              if (alertEl) alertEl.classList.remove('hidden');
            }
          } catch (err: any) {
            if (errorText) errorText.innerText = 'Error finalizing Google sign in.';
            if (alertEl) alertEl.classList.remove('hidden');
          }
        }
      }).catch(err => {
        console.warn('Google redirect result check:', err);
      });
    } catch (e) {
      console.warn('Firebase redirect initialization:', e);
    }

    // Email / Password Form Submit
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const emailInput = document.getElementById('email') as HTMLInputElement | null;
      const passwordInput = document.getElementById('password') as HTMLInputElement | null;
      const email = emailInput?.value?.trim();
      const password = passwordInput?.value;

      if (!email || !password) {
        if (errorText) errorText.innerText = 'Please enter both your email address and password.';
        if (alertEl) alertEl.classList.remove('hidden');
        return;
      }

      if (alertEl) alertEl.classList.add('hidden');
      if (successEl) successEl.classList.add('hidden');
      if (btn) {
        btn.disabled = true;
        btn.innerText = 'Signing In... Please wait...';
      }

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ email, password, redirect }),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          if (errorText) errorText.innerText = data.error || 'Invalid email address or password.';
          if (alertEl) alertEl.classList.remove('hidden');
          if (btn) {
            btn.disabled = false;
            btn.innerText = 'Sign In';
          }
        } else {
          const isStaff = data.user?.role === 'admin' || data.user?.role === 'owner';
          const destination = isStaff ? '/admin' : (data.redirect || redirect);
          if (successText) successText.innerText = `✓ Login successful! Welcome back, ${data.user?.displayName || (isStaff ? 'Administrator' : 'Student')}! Opening ${isStaff ? 'Admin Control Center' : 'dashboard'}...`;
          if (successEl) successEl.classList.remove('hidden');
          if (btn) btn.innerText = '✓ Logged In! Redirecting...';
          window.location.href = destination;
        }
      } catch (err: any) {
        console.error('Fetch login error:', err);
        if (errorText) errorText.innerText = 'Network connection error. Retrying fallback...';
        if (alertEl) alertEl.classList.remove('hidden');
        if (btn) {
          btn.disabled = false;
          btn.innerText = 'Sign In';
        }
      }
    });

    // Google Sign-In with Firebase
    googleBtn?.addEventListener('click', async () => {
      if (alertEl) alertEl.classList.add('hidden');
      if (successEl) successEl.classList.add('hidden');
      googleBtn.disabled = true;
      if (googleBtnText) googleBtnText.innerText = 'Connecting with Google...';

      try {
        const authResult = await signInWithGoogle();
        if (!authResult) {
          if (googleBtnText) googleBtnText.innerText = 'Redirecting to Google...';
          return;
        }

        const { user, idToken } = authResult;

        const res = await fetch('/api/auth/firebase-login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            email: user.email,
            displayName: user.displayName,
            photoUrl: user.photoURL,
            uid: user.uid,
            idToken,
          }),
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          if (errorText) errorText.innerText = data.error || 'Authentication failed. Please verify your credentials.';
          if (alertEl) alertEl.classList.remove('hidden');
          googleBtn.disabled = false;
          if (googleBtnText) googleBtnText.innerText = 'Sign in with Google';
        } else {
          if (successText) successText.innerText = `✓ Google Sign-in successful! Welcome, ${user.displayName || 'Student'}! Opening dashboard...`;
          if (successEl) successEl.classList.remove('hidden');
          if (googleBtnText) googleBtnText.innerText = '✓ Connected! Opening Dashboard...';
          window.location.href = redirect;
        }
      } catch (err: any) {
        console.error('Google Sign-In Error:', err);
        let msg = err?.message || 'Google sign-in was cancelled or failed.';
        if (err?.code === 'auth/popup-blocked') {
          if (errorText) {
            errorText.innerHTML = '⚠️ Pop-up was blocked by your browser. <button type="button" id="retry-google-redirect" class="underline font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 ml-1">Click here to sign in with Google Redirect →</button> or allow pop-ups for this site in your browser.';
            setTimeout(() => {
              document.getElementById('retry-google-redirect')?.addEventListener('click', () => {
                signInWithGoogleRedirect();
              });
            }, 50);
          }
          if (alertEl) alertEl.classList.remove('hidden');
          googleBtn.disabled = false;
          if (googleBtnText) googleBtnText.innerText = 'Sign in with Google';
          return;
        }
        if (err?.code === 'auth/operation-not-allowed' || err?.code === 'auth/configuration-not-found') {
          msg = 'Google single sign-on is currently unavailable. Please sign in with your email and password.';
        }
        if (errorText) errorText.innerText = msg;
        if (alertEl) alertEl.classList.remove('hidden');
        googleBtn.disabled = false;
        if (googleBtnText) googleBtnText.innerText = 'Sign in with Google';
      }
    });

    // Forgot Password Modal Handlers
    const forgotLink = document.getElementById('forgot-password-link');
    const forgotModal = document.getElementById('forgot-modal');
    const forgotModalBox = document.getElementById('forgot-modal-box');
    const closeForgotBtn = document.getElementById('close-forgot-modal');
    const cancelForgotBtn = document.getElementById('cancel-forgot-btn');
    const forgotForm = document.getElementById('forgot-form') as HTMLFormElement;
    const forgotEmailInput = document.getElementById('forgot-email') as HTMLInputElement;
    const forgotAlert = document.getElementById('forgot-alert');
    const forgotErrorText = document.getElementById('forgot-error-text');
    const forgotSuccess = document.getElementById('forgot-success');
    const forgotSubmitBtn = document.getElementById('forgot-submit-btn') as HTMLButtonElement;

    function openForgotModal() {
      const loginEmail = (document.getElementById('email') as HTMLInputElement)?.value;
      if (loginEmail && forgotEmailInput) {
        forgotEmailInput.value = loginEmail;
      }
      if (forgotAlert) forgotAlert.classList.add('hidden');
      if (forgotSuccess) forgotSuccess.classList.add('hidden');
      if (forgotSubmitBtn) {
        forgotSubmitBtn.disabled = false;
        forgotSubmitBtn.innerText = 'Send Reset Link';
      }
      forgotModal?.classList.remove('hidden');
      setTimeout(() => {
        forgotModal?.classList.remove('opacity-0');
        forgotModalBox?.classList.remove('scale-95');
        forgotModalBox?.classList.add('scale-100');
        forgotEmailInput?.focus();
      }, 10);
    }

    function closeForgotModal() {
      forgotModal?.classList.add('opacity-0');
      forgotModalBox?.classList.remove('scale-100');
      forgotModalBox?.classList.add('scale-95');
      setTimeout(() => {
        forgotModal?.classList.add('hidden');
      }, 200);
    }

    forgotLink?.addEventListener('click', openForgotModal);
    closeForgotBtn?.addEventListener('click', closeForgotModal);
    cancelForgotBtn?.addEventListener('click', closeForgotModal);

    forgotModal?.addEventListener('click', (e) => {
      if (e.target === forgotModal) {
        closeForgotModal();
      }
    });

    forgotForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const targetEmail = forgotEmailInput?.value?.trim();
      if (!targetEmail) return;

      if (forgotAlert) forgotAlert.classList.add('hidden');
      if (forgotSuccess) forgotSuccess.classList.add('hidden');
      if (forgotSubmitBtn) {
        forgotSubmitBtn.disabled = true;
        forgotSubmitBtn.innerText = 'Sending Reset Link...';
      }

      try {
        await sendPasswordReset(targetEmail);
        try {
          await fetch('/api/auth/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: targetEmail }),
          });
        } catch {}

        if (forgotSuccess) forgotSuccess.classList.remove('hidden');
        if (forgotSubmitBtn) forgotSubmitBtn.innerText = '✓ Link Sent!';
        setTimeout(() => {
          if (forgotSubmitBtn) {
            forgotSubmitBtn.disabled = false;
            forgotSubmitBtn.innerText = 'Resend Reset Link';
          }
        }, 4000);
      } catch (err: any) {
        console.warn('Firebase password reset error:', err);
        let errorMsg = 'Failed to send password reset email. Please verify the email address.';
        if (err?.code === 'auth/user-not-found') {
          errorMsg = 'No account found with this email address. Please check your spelling or register.';
        } else if (err?.code === 'auth/invalid-email') {
          errorMsg = 'Please enter a valid email address.';
        } else if (err?.code === 'auth/too-many-requests') {
          errorMsg = 'Too many requests. Please wait a few moments before trying again.';
        } else if (err?.message) {
          errorMsg = err.message;
        }

        if (forgotErrorText) forgotErrorText.innerText = errorMsg;
        if (forgotAlert) forgotAlert.classList.remove('hidden');
        if (forgotSubmitBtn) {
          forgotSubmitBtn.disabled = false;
          forgotSubmitBtn.innerText = 'Send Reset Link';
        }
      }
    });
  }

  // Run on first load and on client-side navigations
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLogin);
  } else {
    initLogin();
  }
  document.addEventListener('astro:page-load', initLogin);
</script>
