---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getDb } from '../server/db/mongo';

const reportResourceId = Astro.url.searchParams.get('reportResourceId') || '';
const subjectParam = Astro.url.searchParams.get('subject') || '';

let successMessage = '';
let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const name = formData.get('name')?.toString().trim();
    const email = formData.get('email')?.toString().trim();
    const category = formData.get('category')?.toString().trim() || 'general';
    const resourceId = formData.get('resourceId')?.toString().trim() || '';
    const message = formData.get('message')?.toString().trim();

    if (!name || !email || !message) {
      errorMessage = 'Please complete all required fields.';
    } else {
      const db = await getDb();
      await db.collection('reports').insertOne({
        targetType: resourceId ? 'resource' : 'user',
        targetId: resourceId || 'general-contact',
        reason: category,
        details: message,
        reporterName: name,
        reporterEmail: email,
        status: 'open',
        createdAt: new Date(),
      });

      successMessage = 'Your inquiry/report has been submitted. Our team will review it promptly.';
    }
  } catch (err: any) {
    errorMessage = err?.message || 'Failed to submit report. Please try again.';
  }
}
---

<Layout
  title="Contact & Content Reports | StuddyBuddy"
  description="Contact the StuddyBuddy team or report intellectual property, incorrect exam papers, or platform issues."
>
  <Header slot="header" />

  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-6">
      <div class="border-b border-slate-100 dark:border-slate-800 pb-4">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Contact & Report Content</h1>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Submit feedback, report inaccurate examination metadata, or request intellectual property takedowns.
        </p>
      </div>

      {successMessage && (
        <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs font-semibold">
          {successMessage}
        </div>
      )}

      {errorMessage && (
        <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-300 text-xs font-semibold">
          {errorMessage}
        </div>
      )}

      <form method="POST" class="space-y-4 text-xs">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Your Name <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              name="name"
              required
              class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
          </div>

          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Your Email <span class="text-rose-500">*</span>
            </label>
            <input
              type="email"
              name="email"
              required
              class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
          </div>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Inquiry / Report Category</label>
          <select
            name="category"
            class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
            <option value="copyright" selected={subjectParam.includes('Takedown')}>Copyright / DMCA Takedown</option>
            <option value="misleading">Incorrect / Misleading Academic Metadata</option>
            <option value="inappropriate">Inappropriate / Corrupted Document</option>
            <option value="general" selected={!subjectParam.includes('Takedown')}>General Feedback & Academic Partnerships</option>
          </select>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Target Resource ID or URL (optional)</label>
          <input
            type="text"
            name="resourceId"
            value={reportResourceId}
            placeholder="e.g. res-sample-1 or full resource link"
            class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">
            Details & Message <span class="text-rose-500">*</span>
          </label>
          <textarea
            name="message"
            rows="4"
            required
            placeholder="Please provide full details..."
            class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md transition-transform hover:scale-[1.01]"
        >
          Submit Inquiry
        </button>
      </form>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>
