                    <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                      {fac.name}
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">{university.name}</p>
                  </div>
                  <span class="mt-4 text-xs font-semibold text-indigo-600 dark:text-indigo-400 flex items-center gap-1">
                    Explore Programs →
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </div>

  <!-- Smart Search Catalog Payload & Google-Style Dropdown Script -->
  <script id="smart-search-catalog-data" type="application/json" set:html={JSON.stringify(smartSearchItems)} />

  <script is:inline>
    function initSmartSearch() {
      const input = document.getElementById('smart-search-input');
      const dropdown = document.getElementById('smart-search-dropdown');
      const wrapper = document.getElementById('smart-search-wrapper');
      const clearBtn = document.getElementById('smart-search-clear');
      const dataTag = document.getElementById('smart-search-catalog-data');

      if (!input || !dropdown || !dataTag) return;

      let items = [];
      try {
        items = JSON.parse(dataTag.textContent || '[]');
      } catch (e) {
        items = [];
      }

      let currentMatches = [];
      let selectedIndex = -1;

      function escapeHtml(str) {
        return (str || '').replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
      }

      function highlightMatch(text, query) {
        if (!query) return escapeHtml(text);
        const safeText = escapeHtml(text);
        const escapedQuery = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const regex = new RegExp(`(${escapedQuery})`, 'gi');
        return safeText.replace(regex, '<span class="text-indigo-600 dark:text-indigo-400 font-extrabold underline decoration-indigo-300 dark:decoration-indigo-700">$1</span>');
      }

      function renderDropdown(matches, query) {
        currentMatches = matches;
        selectedIndex = -1;

        if (!matches.length) {
          if (query) {
            dropdown.innerHTML = `
              <div class="p-4 text-center text-xs text-slate-500 dark:text-slate-400">
                No subjects found matching &ldquo;<span class="font-bold text-slate-700 dark:text-slate-200">${escapeHtml(query)}</span>&rdquo;.
                <div class="mt-1 text-[11px] text-slate-400">Press Enter to search all uploaded materials.</div>
              </div>
            `;
            dropdown.classList.remove('hidden');
          } else {
            dropdown.classList.add('hidden');
          }
          return;
        }

        const rows = matches.slice(0, 8).map((item, idx) => {
          const codeText = item.code ? ` (${item.code})` : '';
          const titleWithCode = `${item.name}${codeText}`;
          return `
            <a
              href="${item.url}"
              data-index="${idx}"
              class="smart-dropdown-item flex items-center justify-between px-4 py-3 hover:bg-indigo-50/80 dark:hover:bg-slate-800/80 transition-colors cursor-pointer group"
            >
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-8 h-8 rounded-lg bg-indigo-50 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-xs shrink-0 border border-indigo-100/60 dark:border-indigo-900/60 group-hover:scale-105 transition-transform">
                  ${item.type === 'resource' ? '📄' : '📘'}
                </div>
                <div class="min-w-0 text-left">
                  <div class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors truncate">
                    ${highlightMatch(titleWithCode, query)}
                  </div>
                  <div class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 mt-0.5 truncate">
                    <span class="font-semibold text-indigo-600 dark:text-indigo-400 shrink-0">${escapeHtml(item.semester || 'Curriculum')}</span>
                    <span class="text-slate-300 dark:text-slate-600">•</span>
                    <span class="truncate">${escapeHtml(item.branch || '')}</span>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-1.5 shrink-0 pl-3 text-xs font-semibold text-indigo-600 dark:text-indigo-400 group-hover:translate-x-1 transition-transform">
                <span>Open</span>
                <span>→</span>
              </div>
            </a>
          `;
        }).join('');

        const footer = `
          <div class="px-4 py-2 bg-slate-50 dark:bg-slate-800/60 flex items-center justify-between text-[11px] text-slate-400">
            <span>Use <kbd class="px-1 py-0.5 bg-white dark:bg-slate-700 rounded border border-slate-200 dark:border-slate-600 text-[10px]">↑</kbd> <kbd class="px-1 py-0.5 bg-white dark:bg-slate-700 rounded border border-slate-200 dark:border-slate-600 text-[10px]">↓</kbd> to navigate, <kbd class="px-1 py-0.5 bg-white dark:bg-slate-700 rounded border border-slate-200 dark:border-slate-600 text-[10px]">↵ Enter</kbd> to select</span>
            <span class="text-indigo-600 dark:text-indigo-400 font-semibold">${matches.length} matches</span>
          </div>
        `;

        dropdown.innerHTML = rows + footer;
        dropdown.classList.remove('hidden');
      }

      function updateActive() {
        const dropdownItems = dropdown.querySelectorAll('.smart-dropdown-item');
        dropdownItems.forEach((item, idx) => {
          if (idx === selectedIndex) {
            item.classList.add('bg-indigo-50', 'dark:bg-slate-800');
            item.scrollIntoView({ block: 'nearest' });
          } else {
            item.classList.remove('bg-indigo-50', 'dark:bg-slate-800');
          }
        });
      }

      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        if (clearBtn) {
          if (q) clearBtn.classList.remove('hidden');
          else clearBtn.classList.add('hidden');
        }

        if (!q) {
          dropdown.classList.add('hidden');
          return;
        }

        const matches = items.filter((item) => {
          const nameMatch = item.name && item.name.toLowerCase().includes(q);
          const codeMatch = item.code && item.code.toLowerCase().includes(q);
          const semMatch = item.semester && item.semester.toLowerCase().includes(q);
          const branchMatch = item.branch && item.branch.toLowerCase().includes(q);
          return nameMatch || codeMatch || semMatch || branchMatch;
        });

        renderDropdown(matches, input.value.trim());
      });

      input.addEventListener('keydown', (e) => {
        if (dropdown.classList.contains('hidden')) return;

        const maxIdx = currentMatches.length - 1;
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          selectedIndex = selectedIndex < maxIdx ? selectedIndex + 1 : 0;
          updateActive();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          selectedIndex = selectedIndex > 0 ? selectedIndex - 1 : maxIdx;
          updateActive();
        } else if (e.key === 'Enter') {
          if (selectedIndex >= 0 && currentMatches[selectedIndex]) {
            e.preventDefault();
            window.location.href = currentMatches[selectedIndex].url;
          }
        } else if (e.key === 'Escape') {
          dropdown.classList.add('hidden');
        }
      });

      clearBtn?.addEventListener('click', () => {
        input.value = '';
        clearBtn.classList.add('hidden');
        dropdown.classList.add('hidden');
        input.focus();
      });

      document.addEventListener('click', (e) => {
        if (wrapper && !wrapper.contains(e.target)) {
          dropdown.classList.add('hidden');
        }
      });
    }

    function initDeptModal() {
      const openDeptBtn = document.getElementById('btn-open-dept-modal');
      const closeDeptBtn = document.getElementById('btn-close-dept-modal');
      const cancelDeptBtn = document.getElementById('btn-cancel-dept');
      const deptModal = document.getElementById('add-dept-modal');
      const deptForm = document.getElementById('add-dept-form');
      const deptNameInput = document.getElementById('dept-name-input');
      const deptDescInput = document.getElementById('dept-desc-input');
      const deptError = document.getElementById('dept-error-msg');
      const deptUniSlug = document.getElementById('dept-uni-slug');

      function openModal() {
        if (deptModal) deptModal.classList.remove('hidden');
        if (deptError) deptError.classList.add('hidden');
        if (deptNameInput) deptNameInput.focus();
      }
      function closeModal() {
        if (deptModal) deptModal.classList.add('hidden');
      }

      openDeptBtn?.addEventListener('click', openModal);
      closeDeptBtn?.addEventListener('click', closeModal);
      cancelDeptBtn?.addEventListener('click', closeModal);

      deptForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const facultyName = deptNameInput?.value?.trim();
        const description = deptDescInput?.value?.trim();
        const universitySlug = deptUniSlug?.value;

        if (!facultyName) return;

        try {
          const res = await fetch('/api/universities/faculty', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ universitySlug, facultyName, description }),
          });
          const data = await res.json();
          if (!res.ok) {
            if (deptError) {
              deptError.innerText = data.error || 'Failed to add department.';
              deptError.classList.remove('hidden');
            }
          } else {
            alert(`Department "${facultyName}" added successfully!`);
            location.reload();
          }
        } catch (err) {
          if (deptError) {
            deptError.innerText = 'Network error.';
            deptError.classList.remove('hidden');
          }
        }
      });
    }

    initSmartSearch();
    initDeptModal();
    document.addEventListener('DOMContentLoaded', () => {
      initSmartSearch();
      initDeptModal();
    });
    document.addEventListener('astro:page-load', () => {
      initSmartSearch();
      initDeptModal();
    });
  </script>

  <Footer slot="footer" />
</Layout>
