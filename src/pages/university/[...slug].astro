---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ResourceCard from '../../components/resources/ResourceCard.astro';
import RecentResourceCard from '../../components/resources/RecentResourceCard.astro';
import SemesterCard from '../../components/academic/SemesterCard.astro';
import SubjectCard from '../../components/academic/SubjectCard.astro';
import AcademicBreadcrumb from '../../components/academic/AcademicBreadcrumb.astro';
import {
  getUniversityBySlug,
  getFacultiesByUniversity,
  getFacultyBySlug,
  getProgramsByFaculty,
  getProgramBySlug,
  getAcademicTermsByProgram,
  getAcademicTermBySlug,
  getSubjectsByProgramAndTerm,
  getSubjectsByProgram,
  getSubjectBySlug,
  getUniversitySearchItems,
} from '../../server/repositories/catalogRepository';
import { searchResources, getRecentlyViewedResources } from '../../server/repositories/resourceRepository';
import type { Resource } from '../../types';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/university/parul-university');
}

const parts = slug.split('/').filter(Boolean);
const uniSlug = parts[0] || 'parul-university';
const facultySlug = parts[1];
const programSlug = parts[2];
const termSlug = parts[3];
const subjectSlug = parts[4];

// 1. Fetch University with resilient fallback
let university: any = null;
try {
  university = await getUniversityBySlug(uniSlug);
} catch {}

if (!university) {
  const rawUni = uniSlug.replace(/-/g, ' ');
  const capUni = rawUni.charAt(0).toUpperCase() + rawUni.slice(1);
  university = {
    _id: uniSlug,
    name: capUni,
    slug: uniSlug,
    location: 'Campus Academic Directory',
    description: `Academic departments, curriculum programs, past exam papers, and verified notes for ${capUni}.`,
    isActive: true,
    createdAt: new Date('2024-01-01'),
    updatedAt: new Date('2024-01-01'),
  };
}

// State containers
let faculty: any = null;
let program: any = null;
let term: any = null;
let subject: any = null;

let faculties: any[] = [];
let programs: any[] = [];
let terms: any[] = [];
let subjects: any[] = [];
let resources: Resource[] = [];
let categoryCounts: Record<string, number> = {};

// Level 1 University Space: Smart Search & Recently Viewed state
let recentlyViewed: Array<Resource & { viewedAt: Date }> = [];
let searchQuery = '';
let searchResults: Resource[] = [];
let searchTotal = 0;
let smartSearchItems: any[] = [];
let matchingSubjects: any[] = [];

let activeCategoryMeta = {
  title: 'All Study Materials',
  shortTitle: 'Document',
  icon: '📁',
  description: 'All academic materials, question papers, and notes for this subject.',
  uploadCategory: 'Notes',
};

// Filter category from query params on subject hub
const selectedCategory = Astro.url.searchParams.get('category') || 'all';

// 2. Resolve Hierarchy based on depth with full dynamic fallbacks
if (facultySlug) {
  try {
    faculty = await getFacultyBySlug(uniSlug, facultySlug);
  } catch {}
  if (!faculty) {
    const rawFac = facultySlug.replace(/^fac-/, '').replace(/-/g, ' ');
    const capFac = rawFac.charAt(0).toUpperCase() + rawFac.slice(1);
    faculty = {
      _id: `fac-${facultySlug}`,
      universityId: uniSlug,
      name: capFac,
      slug: facultySlug,
      isActive: true,
      createdAt: new Date('2024-01-01'),
      updatedAt: new Date('2024-01-01'),
    };
  }
}

if (facultySlug && programSlug) {
  try {
    program = await getProgramBySlug(programSlug);
  } catch {}
  if (!program) {
    const rawProg = programSlug.replace(/-/g, ' ');
    const capProg = rawProg.charAt(0).toUpperCase() + rawProg.slice(1);
    program = {
      _id: `prog-${programSlug}`,
      universityId: uniSlug,
      facultyId: faculty?._id?.toString() || `fac-${facultySlug}`,
      name: capProg,
      slug: programSlug,
      code: 'CORE',
      structureType: 'semester',
      durationYears: 4,
      totalTerms: 8,
      isActive: true,
      createdAt: new Date('2024-01-01'),
      updatedAt: new Date('2024-01-01'),
    };
  }
}

if (program && termSlug) {
  try {
    term = await getAcademicTermBySlug(programSlug, termSlug);
  } catch {}
  if (!term) {
    const orderIndex = parseInt(termSlug.replace(/\D/g, ''), 10) || 1;
    term = {
      _id: `term-${programSlug}-${orderIndex}`,
      programId: program._id?.toString() || `prog-${programSlug}`,
      name: `Semester ${orderIndex}`,
      slug: termSlug,
      orderIndex,
      isActive: true,
      createdAt: new Date('2024-01-01'),
      updatedAt: new Date('2024-01-01'),
    };
  }
}

if (program && subjectSlug) {
  try {
    subject = await getSubjectBySlug(subjectSlug);
  } catch {}
  if (!subject) {
    const rawSubj = subjectSlug.replace(/-/g, ' ');
    const capSubj = rawSubj.charAt(0).toUpperCase() + rawSubj.slice(1);
    subject = {
      _id: `subj-${subjectSlug}`,
      programId: program._id?.toString() || `prog-${programSlug}`,
      academicTermId: term?._id || 'term-1',
      name: capSubj,
      slug: subjectSlug,
      code: subjectSlug.toUpperCase().slice(0, 6),
      isActive: true,
      createdAt: new Date('2024-01-01'),
      updatedAt: new Date('2024-01-01'),
    };
  }
}

// Breadcrumb builder
const breadcrumbItems: Array<{ label: string; href?: string }> = [
  { label: university.name, href: `/university/${uniSlug}` },
];

if (faculty) {
  breadcrumbItems.push({
    label: faculty.name,
    href: `/university/${uniSlug}/${faculty.slug}`,
  });
}

if (program) {
  breadcrumbItems.push({
    label: program.name,
    href: `/university/${uniSlug}/${faculty?.slug || 'faculty'}/${program.slug}`,
  });
}

if (term) {
  breadcrumbItems.push({
    label: term.name,
    href: `/university/${uniSlug}/${faculty?.slug || 'faculty'}/${program?.slug}/${term.slug}`,
  });
}

if (subject) {
  breadcrumbItems.push({
    label: subject.name,
  });
}

// Calculate Back Href
let backHref = '/';
if (subject && term) {
  backHref = `/university/${uniSlug}/${faculty?.slug}/${program?.slug}/${term.slug}`;
} else if (term && program) {
  backHref = `/university/${uniSlug}/${faculty?.slug}/${program?.slug}`;
} else if (program && faculty) {
  backHref = `/university/${uniSlug}/${faculty?.slug}`;
} else if (faculty) {
  backHref = `/university/${uniSlug}`;
}

// Level Specific Data Fetching
if (subject) {
  // LEVEL 5: Dedicated Subject Resource Hub
  const subjectId = subject._id?.toString() || `subj-${subject.slug}`;
  
  // Fetch all resources for subject to calculate category counts
  const allSubjectRes = await searchResources({
    status: 'approved',
    subjectId,
    limit: 50,
  });

  const subjectItems = allSubjectRes.resources;
  categoryCounts = {
    all: subjectItems.length,
    pyq: subjectItems.filter((r) => r.category.toLowerCase().includes('question') || r.category.toLowerCase().includes('paper')).length,
    notes: subjectItems.filter((r) => r.category.toLowerCase().includes('note') || r.category.toLowerCase().includes('assignment')).length,
    syllabus: subjectItems.filter((r) => r.category.toLowerCase().includes('syllabus')).length,
    lab: subjectItems.filter((r) => r.category.toLowerCase().includes('lab') || r.category.toLowerCase().includes('practical')).length,
    formula: subjectItems.filter((r) => r.category.toLowerCase().includes('formula')).length,
    bank: subjectItems.filter((r) => r.category.toLowerCase().includes('bank')).length,
  };

  // Filter resources based on active category
  if (selectedCategory === 'all') {
    resources = subjectItems;
  } else if (selectedCategory === 'pyq') {
    resources = subjectItems.filter((r) => r.category.toLowerCase().includes('question') || r.category.toLowerCase().includes('paper') || r.category.toLowerCase().includes('pyq'));
  } else if (selectedCategory === 'notes') {
    resources = subjectItems.filter((r) => r.category.toLowerCase().includes('note') || r.category.toLowerCase().includes('assignment') || r.category.toLowerCase().includes('ppt') || r.category.toLowerCase().includes('presentation'));
  } else if (selectedCategory === 'syllabus') {
    resources = subjectItems.filter((r) => r.category.toLowerCase().includes('syllabus'));
  } else if (selectedCategory === 'lab') {
    resources = subjectItems.filter((r) => r.category.toLowerCase().includes('lab') || r.category.toLowerCase().includes('practical') || r.category.toLowerCase().includes('viva'));
  } else if (selectedCategory === 'formula') {
    resources = subjectItems.filter((r) => r.category.toLowerCase().includes('formula'));
  } else if (selectedCategory === 'bank') {
    resources = subjectItems.filter((r) => r.category.toLowerCase().includes('bank') || r.category.toLowerCase().includes('unit'));
  } else {
    resources = subjectItems;
  }

  // Active Category Metadata Definition
  const CATEGORY_META: Record<string, { title: string; shortTitle: string; icon: string; description: string; uploadCategory: string }> = {
    pyq: {
      title: 'Previous Year Papers (PYQs)',
      shortTitle: 'PYQ Question Paper',
      icon: '📝',
      description: `Past mid-semester, end-semester, and remedial question papers for ${subject.name}.`,
      uploadCategory: 'Previous Year Question Paper',
    },
    notes: {
      title: 'Notes & Assignments',
      shortTitle: 'Lecture Notes',
      icon: '📚',
      description: `Handwritten lecture notes, slides, and assignment questions for ${subject.name}.`,
      uploadCategory: 'Notes',
    },
    syllabus: {
      title: 'Syllabus & Units',
      shortTitle: 'Syllabus',
      icon: '📋',
      description: `Official curriculum syllabus, unit breakdown, and textbook references for ${subject.name}.`,
      uploadCategory: 'Syllabus & Units',
    },
    lab: {
      title: 'Lab Manual & VIVA',
      shortTitle: 'Lab Manual',
      icon: '🔬',
      description: `Practical lab manuals, experiment guides, and viva voce questions for ${subject.name}.`,
      uploadCategory: 'Practical & Lab Material',
    },
    bank: {
      title: 'Question Bank & All Units',
      shortTitle: 'Question Bank',
      icon: '📑',
      description: `Important 2-mark and 7-mark question banks with unit-wise solutions for ${subject.name}.`,
      uploadCategory: 'Question Bank',
    },
    formula: {
      title: 'Formula Sheets',
      shortTitle: 'Formula Sheet',
      icon: '📐',
      description: `Quick reference formula sheets and revision summaries for ${subject.name}.`,
      uploadCategory: 'Formula Sheet',
    },
    all: {
      title: 'All Study Materials',
      shortTitle: 'Document',
      icon: '📁',
      description: `All lecture notes, past exam papers, lab files, and question banks for ${subject.name}.`,
      uploadCategory: 'Notes',
    },
  };

  activeCategoryMeta = CATEGORY_META[selectedCategory] || CATEGORY_META.all;

} else if (term) {
  // LEVEL 4: Semester Page -> List Curriculum Subjects
  try {
    subjects = await getSubjectsByProgramAndTerm(programSlug, term.orderIndex);
  } catch {
    subjects = [];
  }

} else if (program) {
  // LEVEL 3: Program Page -> List Semesters
  try {
    terms = await getAcademicTermsByProgram(programSlug);
  } catch {
    terms = [];
  }
  try {
    subjects = await getSubjectsByProgram(programSlug);
  } catch {
    subjects = [];
  }

} else if (faculty) {
  // LEVEL 2: Faculty/Department Page -> List Programs
  try {
    programs = await getProgramsByFaculty(faculty._id?.toString() || faculty.slug);
  } catch {
    programs = [];
  }

} else {
  // LEVEL 1: University Overview -> List Faculties / Departments
  try {
    faculties = await getFacultiesByUniversity(uniSlug);
  } catch {
    faculties = [];
  }
  try {
    smartSearchItems = await getUniversitySearchItems(uniSlug);
  } catch {
    smartSearchItems = [];
  }

  try {
    const currentUser = Astro.locals.user;
    if (currentUser?.id) {
      recentlyViewed = await getRecentlyViewedResources(currentUser.id, uniSlug, 6);
    }
  } catch {
    recentlyViewed = [];
  }

  // University-Specific Smart Search query
  const q = (Astro.url.searchParams.get('q') || Astro.url.searchParams.get('search') || '').trim();
  if (q) {
    searchQuery = q;
    const qLower = q.toLowerCase();
    matchingSubjects = smartSearchItems.filter(
      (item) =>
        item.name.toLowerCase().includes(qLower) ||
        (item.code && item.code.toLowerCase().includes(qLower)) ||
        item.semester.toLowerCase().includes(qLower) ||
        item.branch.toLowerCase().includes(qLower)
    );

    try {
      const searchRes = await searchResources({
        search: q,
        universityId: uniSlug,
        status: 'approved',
        limit: 24,
      });
      searchResults = searchRes.resources || [];
      searchTotal = searchResults.length + matchingSubjects.length;
    } catch {
      searchResults = [];
      searchTotal = matchingSubjects.length;
    }
  }
}

// Dynamic Titles
let pageTitle = `${university.name} — Student Academic Resources`;
let pageDescription = `Browse verified academic materials, syllabus, and question papers for ${university.name}.`;

if (subject) {
  pageTitle = `${subject.name} (${subject.code || 'Study Hub'}) — Notes, PYQs & Syllabus | ${university.name}`;
  pageDescription = `Download ${subject.name} previous year question papers, handwritten lecture notes, and formula sheets for ${program?.name || 'Students'} at ${university.name}.`;
} else if (term) {
  pageTitle = `${term.name} Subjects & Study Materials — ${program?.name} | ${university.name}`;
  pageDescription = `Curriculum subjects, notes, and exam papers for ${program?.name} ${term.name} at ${university.name}.`;
} else if (program) {
  pageTitle = `${program.name} Semesters & Question Papers | ${university.name}`;
  pageDescription = `Select semester and access course resources for ${program.name} at ${university.name}.`;
} else if (faculty) {
  pageTitle = `${faculty.name} Departments & Programs | ${university.name}`;
  pageDescription = `Explore courses, branches, and academic materials under ${faculty.name} at ${university.name}.`;
}
---

<Layout title={pageTitle} description={pageDescription}>
  <Header slot="header" user={Astro.locals.user} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Academic Breadcrumb Bar -->
    <AcademicBreadcrumb items={breadcrumbItems} backHref={backHref} />

    <!-- ======================================================== -->
    <!-- LEVEL 5: SUBJECT RESOURCE HUB                            -->
    <!-- ======================================================== -->
    {subject && (
      <div class="space-y-8">
        <!-- Direct Category Focused Hero Banner -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <a
                href={backHref}
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-100 hover:bg-indigo-50 dark:bg-slate-800 dark:hover:bg-indigo-950/70 text-slate-700 hover:text-indigo-600 dark:text-slate-300 dark:hover:text-indigo-400 transition-colors"
              >
                <span>← Back to {term?.name || 'Semester'} Subjects</span>
              </a>
              {subject.code && (
                <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800">
                  {subject.code}
                </span>
              )}
              <span class="text-xs text-slate-400 font-medium">
                {program?.name} • {university.name}
              </span>
            </div>

            <div class="flex items-center gap-3 pt-1">
              <span class="text-3xl sm:text-4xl">{activeCategoryMeta.icon}</span>
              <div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                  {activeCategoryMeta.title}
                </h1>
                <p class="text-xs sm:text-sm font-semibold text-indigo-600 dark:text-indigo-400">
                  {subject.name}
                </p>
              </div>
            </div>

            <p class="text-xs text-slate-500 dark:text-slate-400 max-w-2xl leading-relaxed">
              {activeCategoryMeta.description}
            </p>
          </div>

          <!-- Direct Upload CTA for THIS exact category -->
          <div class="shrink-0">
            <a
              href={`/upload?university=${encodeURIComponent(university.slug)}&faculty=${encodeURIComponent(faculty?.slug || '')}&program=${encodeURIComponent(program?.slug || '')}&term=${encodeURIComponent(term?.slug || '')}&subject=${encodeURIComponent(subject.slug)}&category=${encodeURIComponent(activeCategoryMeta.uploadCategory)}`}
              class="px-5 py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-md shadow-indigo-600/20 transition-all hover:scale-105 flex items-center gap-2"
            >
              <span>+ Upload {activeCategoryMeta.shortTitle}</span>
            </a>
          </div>
        </div>

        <!-- Sleek Horizontal Category Switcher Bar (Tabs) -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs font-bold text-slate-400 uppercase tracking-wider px-1">
            <span>Category Filter:</span>
            <span class="text-[11px] font-semibold text-slate-500">{resources.length} {resources.length === 1 ? 'document' : 'documents'} available</span>
          </div>

          <div class="flex flex-wrap gap-2 p-1.5 rounded-2xl bg-slate-100/80 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-800">
            {[
              { id: 'all', label: 'All Materials', count: categoryCounts.all || 0 },
              { id: 'pyq', label: 'PYQs', count: categoryCounts.pyq || 0 },
              { id: 'notes', label: 'Notes & Assignment', count: categoryCounts.notes || 0 },
              { id: 'syllabus', label: 'Syllabus', count: categoryCounts.syllabus || 0 },
              { id: 'lab', label: 'Lab Manual & Viva', count: categoryCounts.lab || 0 },
              { id: 'bank', label: 'Question Bank', count: categoryCounts.bank || 0 },
              { id: 'formula', label: 'Formula Sheets', count: categoryCounts.formula || 0 },
            ].map((tab) => {
              const isActive = selectedCategory === tab.id;
              return (
                <a
                  href={`/university/${uniSlug}/${facultySlug}/${programSlug}/${termSlug}/${subjectSlug}?category=${tab.id}`}
                  class={`px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 ${
                    isActive
                      ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/20'
                      : 'text-slate-600 dark:text-slate-300 hover:bg-white dark:hover:bg-slate-700/80'
                  }`}
                >
                  <span>{tab.label}</span>
                  <span class={`px-1.5 py-0.5 rounded-full text-[10px] font-bold ${isActive ? 'bg-indigo-700 text-indigo-100' : 'bg-slate-200/80 dark:bg-slate-700 text-slate-500 dark:text-slate-300'}`}>
                    {tab.count}
                  </span>
                </a>
              );
            })}
          </div>
        </div>

        <!-- Resources Content for THIS Specific Category -->
        <div class="space-y-6 pt-2">
          {resources.length > 0 ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {resources.map((res) => (
                <ResourceCard resource={res} />
              ))}
            </div>
          ) : (
            <div class="p-12 sm:p-16 text-center bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 space-y-4 shadow-sm">
              <div class="w-16 h-16 mx-auto rounded-3xl bg-indigo-50 dark:bg-indigo-950/70 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-3xl font-bold shadow-inner">
                {activeCategoryMeta.icon}
              </div>
              <div class="space-y-1">
                <h3 class="text-xl font-bold text-slate-900 dark:text-white">
                  No {activeCategoryMeta.title} Uploaded Yet
                </h3>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto leading-relaxed">
                  Be the first student to upload {activeCategoryMeta.shortTitle.toLowerCase()} for <span class="font-semibold text-slate-700 dark:text-slate-200">{subject.name}</span>! It will be instantly available to all classmates.
                </p>
              </div>

              <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
                <a
                  href={`/upload?university=${encodeURIComponent(university.slug)}&faculty=${encodeURIComponent(faculty?.slug || '')}&program=${encodeURIComponent(program?.slug || '')}&term=${encodeURIComponent(term?.slug || '')}&subject=${encodeURIComponent(subject.slug)}&category=${encodeURIComponent(activeCategoryMeta.uploadCategory)}`}
                  class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-lg shadow-indigo-600/30 transition-transform hover:scale-105"
                >
                  <span>🚀 Upload {activeCategoryMeta.shortTitle} Now</span>
                </a>
                {selectedCategory !== 'all' && (
                  <a
                    href={`/university/${uniSlug}/${facultySlug}/${programSlug}/${termSlug}/${subjectSlug}?category=all`}
                    class="inline-flex items-center gap-2 px-4 py-3 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold text-xs rounded-xl transition-colors"
                  >
                    <span>View All Materials ({categoryCounts.all || 0})</span>
                  </a>
                )}
              </div>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- ======================================================== -->
    <!-- LEVEL 4: SEMESTER SUBJECTS GRID                          -->
    <!-- ======================================================== -->
    {!subject && term && (
      <div class="space-y-8">
        <!-- Semester Centered Header matching screenshot -->
        <div class="text-center space-y-2 py-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800">
            <span>{program?.name}</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
            {term.name}
          </h1>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-lg mx-auto">
            Choose any study material category directly from the course cards below.
          </p>
        </div>

        <!-- Subjects Grid with Direct Category Action Cards -->
        {subjects.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            {subjects.map((subj) => (
              <SubjectCard
                subject={subj}
                baseHref={`/university/${uniSlug}/${facultySlug}/${programSlug}/${termSlug}/${subj.slug}`}
              />
            ))}
          </div>
        ) : (
          <div class="p-12 text-center bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 space-y-4 shadow-sm">
            <div class="w-14 h-14 mx-auto rounded-2xl bg-indigo-50 dark:bg-indigo-950/70 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-2xl font-bold">
              📚
            </div>
            <div class="space-y-1">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                No Subjects Listed for {term.name}
              </h3>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto">
                Be the first to share question papers or notes for this semester!
              </p>
