                    auditLogs.map((log) => (
                      <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
                        <td class="p-3.5 text-slate-400">
                          {new Date(log.createdAt).toLocaleString()}
                        </td>
                        <td class="p-3.5 font-semibold text-slate-800 dark:text-slate-200">
                          {log.actorEmail}
                        </td>
                        <td class="p-3.5">
                          <span class="px-2 py-0.5 rounded font-bold uppercase text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                            {log.action}
                          </span>
                        </td>
                        <td class="p-3.5 text-slate-500">
                          {log.targetType}:{log.targetId}
                        </td>
                        <td class="p-3.5 text-slate-600 dark:text-slate-400">
                          {log.reason || '-'}
                        </td>
                      </tr>
                    ))
                  ) : (
                    <tr>
                      <td colspan="5" class="p-6 text-center text-slate-400 text-xs">
                        No audit records logged yet.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </section>

      </main>

      <Footer slot="footer" />
    </div>
  </div>
</Layout>

<script is:inline>
  // ==========================================
  // 1. COLLAPSIBLE SIDEBAR WITH LOCALSTORAGE
  // ==========================================
  const sidebar = document.getElementById('admin-sidebar');
  const mainWrapper = document.getElementById('admin-main-wrapper');
  const toggleBtn = document.getElementById('sidebar-toggle-btn');
  const toggleIcon = document.getElementById('sidebar-toggle-icon');

  const STORAGE_KEY = 'studdybuddy_admin_sidebar_collapsed';

  function applySidebarState(collapsed) {
    if (!sidebar || !mainWrapper) return;

    const sidebarTexts = sidebar.querySelectorAll('.sidebar-text');
    const sidebarBadges = sidebar.querySelectorAll('.sidebar-badge');

    if (collapsed) {
      sidebar.classList.remove('w-64');
      sidebar.classList.add('w-20');
      mainWrapper.classList.remove('lg:pl-64');
      mainWrapper.classList.add('lg:pl-20');

      if (toggleIcon) toggleIcon.classList.add('rotate-180');

      sidebarTexts.forEach((el) => {
        el.classList.add('hidden', 'opacity-0');
      });
      sidebarBadges.forEach((el) => {
        el.classList.add('hidden');
      });
    } else {
      sidebar.classList.remove('w-20');
      sidebar.classList.add('w-64');
      mainWrapper.classList.remove('lg:pl-20');
      mainWrapper.classList.add('lg:pl-64');

      if (toggleIcon) toggleIcon.classList.remove('rotate-180');

      sidebarTexts.forEach((el) => {
        el.classList.remove('hidden', 'opacity-0');
      });
      sidebarBadges.forEach((el) => {
        el.classList.remove('hidden');
      });
    }
  }

  // Read initial state
  const isCollapsedInitial = localStorage.getItem(STORAGE_KEY) === 'true';
  applySidebarState(isCollapsedInitial);

  toggleBtn?.addEventListener('click', () => {
    const currentlyCollapsed = sidebar?.classList.contains('w-20') || false;
    const newState = !currentlyCollapsed;
    applySidebarState(newState);
    localStorage.setItem(STORAGE_KEY, String(newState));
  });

  // ==========================================
  // 1.5 TABBED SINGLE-VIEW WORKSPACE SWITCHER
  // ==========================================
  const VIEW_STORAGE_KEY = 'studdybuddy_admin_active_view';
  const navTabs = document.querySelectorAll('[data-admin-tab]');
  const allViews = document.querySelectorAll('.admin-view');
  const viewSwitchButtons = document.querySelectorAll('[data-view-target]');

  function switchAdminView(targetViewId) {
    if (!targetViewId) targetViewId = 'overview';
    // Normalize aliases
    if (targetViewId === 'colleges') targetViewId = 'campuses';
    if (targetViewId === 'moderation') targetViewId = 'documents';

    let matched = false;
    allViews.forEach((view) => {
      if (view.id === `view-${targetViewId}`) {
        view.classList.remove('hidden');
        matched = true;
      } else {
        view.classList.add('hidden');
      }
    });

    if (!matched) {
      targetViewId = 'overview';
      const overviewEl = document.getElementById('view-overview');
      if (overviewEl) overviewEl.classList.remove('hidden');
    }

    // Update active nav styling
    navTabs.forEach((tab) => {
      const tabId = tab.getAttribute('data-admin-tab');
      if (tabId === targetViewId) {
        tab.classList.add('bg-indigo-50', 'dark:bg-indigo-950/70', 'text-indigo-600', 'dark:text-indigo-400', 'font-bold', 'border-l-4', 'border-indigo-600', 'dark:border-indigo-400', 'pl-2', 'shadow-sm');
        tab.classList.remove('text-slate-700', 'dark:text-slate-200', 'hover:bg-slate-100', 'dark:hover:bg-slate-800');
      } else {
        tab.classList.remove('bg-indigo-50', 'dark:bg-indigo-950/70', 'text-indigo-600', 'dark:text-indigo-400', 'font-bold', 'border-l-4', 'border-indigo-600', 'dark:border-indigo-400', 'pl-2', 'shadow-sm');
        tab.classList.add('text-slate-700', 'dark:text-slate-200', 'hover:bg-slate-100', 'dark:hover:bg-slate-800');
      }
    });

    try {
      localStorage.setItem(VIEW_STORAGE_KEY, targetViewId);
      const url = new URL(window.location.href);
      url.searchParams.set('view', targetViewId);
      url.hash = '';
      window.history.replaceState({ view: targetViewId }, '', url.toString());
    } catch {}

    window.scrollTo({ top: 0, behavior: 'instant' });
  }

  navTabs.forEach((tab) => {
    tab.addEventListener('click', (e) => {
      e.preventDefault();
      const tabId = tab.getAttribute('data-admin-tab');
      if (tabId) switchAdminView(tabId);
    });
  });

  viewSwitchButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const tabId = btn.getAttribute('data-view-target');
      if (tabId) switchAdminView(tabId);
    });
  });

  // Activate view on initial load
  try {
    const urlParams = new URLSearchParams(window.location.search);
    const hash = window.location.hash.replace('#', '');
    const stored = localStorage.getItem(VIEW_STORAGE_KEY);
    const initialView = urlParams.get('view') || hash || stored || 'overview';
    switchAdminView(initialView);
  } catch {
    switchAdminView('overview');
  }

  // ==========================================
  // 2. RESOURCE MODERATION
  // ==========================================
  async function moderateResource(resourceId, action) {
    let reason = '';
    if (action === 'reject') {
      reason = prompt('Enter rejection reason for contributor:');
      if (reason === null) return;
    }

    try {
      const res = await fetch('/api/admin/moderation', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ resourceId, action, reason }),
      });

      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'Moderation action failed.');
      } else {
        const row = document.getElementById(`res-row-${resourceId}`);
        if (row) row.remove();
        alert(`Resource successfully ${action}ed!`);
        location.reload();
      }
    } catch (err) {
      alert('Network error.');
    }
  }

  async function deleteResourceAdmin(resourceId, title) {
    if (!confirm(`Are you sure you want to permanently delete "${title}"? This cannot be undone.`)) {
      return;
    }

    try {
      const res = await fetch('/api/admin/moderation', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ resourceId, action: 'delete' }),
      });

      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'Delete action failed.');
      } else {
        const row = document.getElementById(`live-res-row-${resourceId}`);
        if (row) row.remove();
        alert(`Resource "${title}" was permanently removed.`);
      }
    } catch (err) {
      alert('Network error.');
    }
  }

  async function manageUser(userId, action) {
    let reason = '';
    if (action === 'suspend' || action === 'restrict_uploads') {
      reason = prompt(`Enter reason for ${action}:`);
      if (reason === null) return;
    }

    try {
      const res = await fetch('/api/admin/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId, action, reason }),
      });

      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'User management action failed.');
      } else {
        alert(`User updated successfully!`);
        location.reload();
      }
    } catch (err) {
      alert('Network error.');
    }
  }

  // ==========================================
  // 3. BROADCAST ANNOUNCEMENTS
  // ==========================================
  async function broadcastAnnouncement(e) {
    e.preventDefault();
    const title = document.getElementById('notif-input-title').value.trim();
    const content = document.getElementById('notif-input-content').value.trim();
    const priority = document.getElementById('notif-input-priority').value;
    const callToActionLabel = document.getElementById('notif-input-cta-label').value.trim();
    const callToActionUrl = document.getElementById('notif-input-cta-url').value.trim();

    if (!title || !content) {
      alert('Please provide both headline title and announcement message.');
      return;
    }

    const submitBtn = document.getElementById('notif-submit-btn');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerText = 'Broadcasting...';
    }

    try {
      const res = await fetch('/api/admin/announcements', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, content, priority, callToActionLabel, callToActionUrl }),
      });

      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'Failed to broadcast announcement.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = '🚀 Broadcast Notification Now';
        }
      } else {
        alert('Campus announcement successfully broadcasted to ALL visitors (guests & students)!');
        location.reload();
      }
    } catch (err) {
      alert('Network error while broadcasting announcement.');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerText = '🚀 Broadcast Notification Now';
      }
    }
  }

  // ==========================================
  // 4. UNIVERSITY REQUEST MODERATION
  // ==========================================
  async function moderateUniversityRequest(requestId, action, uniName) {
    let reason = '';
    if (action === 'reject') {
      reason = prompt(`Enter rejection reason for "${uniName}":`);
      if (reason === null) return;
    } else {
      if (!confirm(`Are you sure you want to approve "${uniName}"? This will make the university live across StuddyBuddy and publish an announcement to all students.`)) {
        return;
      }
    }

    try {
      const res = await fetch('/api/admin/university-requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ requestId, action, reason }),
      });

      const data = await res.json();
      if (!res.ok) {
        alert(data.error || `Failed to ${action} university request.`);
      } else {
        alert(data.message || `University request ${action}ed successfully!`);
        location.reload();
      }
    } catch (err) {
      alert('Network error while processing university request.');
    }
  }

  async function deleteAnnouncementAdmin(id, title) {
    if (!confirm(`Are you sure you want to delete the broadcast "${title}"? This will remove it for all users.`)) {
      return;
    }

    try {
      const res = await fetch(`/api/admin/announcements?id=${id}`, {
        method: 'DELETE',
      });

      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'Failed to delete announcement.');
      } else {
        const row = document.getElementById(`announcement-row-${id}`);
        if (row) row.remove();
        alert(`Announcement "${title}" was permanently removed.`);
      }
    } catch (err) {
      alert('Network error.');
    }
  }

  const broadcastForm = document.getElementById('broadcast-form');
  if (broadcastForm) {
    broadcastForm.addEventListener('submit', broadcastAnnouncement);
  }
</script>
