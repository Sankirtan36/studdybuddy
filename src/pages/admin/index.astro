---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getDb } from '../../server/db/mongo';
import { readLocalUsers } from '../../server/auth/userStore';
import { readLocalResources } from '../../server/repositories/resourceRepository';
import { getAllAnnouncements } from '../../server/repositories/announcementRepository';
import { getAllUniversityRequests } from '../../server/repositories/universityRequestRepository';
import type { Resource, User, CatalogSuggestion, ContentReport, AuditLog, Announcement, UniversityRequest } from '../../types';
import fs from 'node:fs';
import path from 'node:path';

// Authentication & Strict RBAC Enforcement
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/admin/login');
}
if (user.role !== 'admin' && user.role !== 'owner') {
  return Astro.redirect('/dashboard?error=unauthorized_admin');
}

let pendingResources: Resource[] = [];
let allResources: Resource[] = [];
let announcementsList: Announcement[] = [];
let approvedCount = 0;
let pendingCount = 0;
let rejectedCount = 0;
let totalUsersCount = 0;
let usersList: User[] = [];
let pendingSuggestions: CatalogSuggestion[] = [];
let openReports: ContentReport[] = [];
let auditLogs: AuditLog[] = [];
let totalStoredBytes = 0;
let mongoConnected = false;

try {
  const db = await getDb();
  mongoConnected = true;

  // Metrics
  totalUsersCount = await db.collection('users').countDocuments({});
  approvedCount = await db.collection('resources').countDocuments({ status: { $in: ['approved', 'published'] } });
  pendingCount = await db.collection('resources').countDocuments({ status: 'pending' });
  rejectedCount = await db.collection('resources').countDocuments({ status: 'rejected' });

  // Storage
  const storageAgg = await db.collection('resources').aggregate([
    { $match: { status: { $ne: 'removed' } } },
    { $group: { _id: null, totalBytes: { $sum: '$fileSizeBytes' } } },
  ]).toArray();
  totalStoredBytes = storageAgg[0]?.totalBytes || 0;

  // Pending Moderation Queue
  pendingResources = await db
    .collection<Resource>('resources')
    .find({ status: 'pending' })
    .sort({ createdAt: -1 })
    .limit(25)
    .toArray();

  // All Resources for Admin Management
  allResources = await db
    .collection<Resource>('resources')
    .find({ status: { $ne: 'removed' } })
    .sort({ createdAt: -1 })
    .limit(50)
    .toArray();

  // User list
  usersList = await db
    .collection<User>('users')
    .find({})
    .sort({ createdAt: -1 })
    .limit(50)
    .toArray();

  // Pending Catalog Suggestions
  pendingSuggestions = await db
    .collection<CatalogSuggestion>('catalogSuggestions')
    .find({ status: 'pending' })
    .sort({ createdAt: -1 })
    .limit(20)
    .toArray();

  // Open Reports
  openReports = await db
    .collection<ContentReport>('reports')
    .find({ status: 'open' })
    .sort({ createdAt: -1 })
    .limit(20)
    .toArray();

  // Audit Logs
  auditLogs = await db
    .collection<AuditLog>('auditLogs')
    .find({})
    .sort({ createdAt: -1 })
    .limit(25)
    .toArray();
} catch (err) {
  // Seamless fallback to local file-based database
  mongoConnected = false;
  usersList = readLocalUsers();
  totalUsersCount = usersList.length;

  const localRes = readLocalResources();
  allResources = localRes.filter((r) => (r.status as string) !== 'removed');
  pendingResources = localRes.filter((r) => r.status === 'pending');
  pendingCount = pendingResources.length;
  approvedCount = localRes.filter((r) => r.status === 'approved' || (r.status as string) === 'published').length;
  rejectedCount = localRes.filter((r) => r.status === 'rejected').length;
  totalStoredBytes = localRes.reduce((acc, r) => acc + (r.fileSizeBytes || 0), 0);

  // Read local audit logs if available
  try {
    const auditFile = path.resolve(process.cwd(), '.data', 'auditLogs.json');
    if (fs.existsSync(auditFile)) {
      auditLogs = JSON.parse(fs.readFileSync(auditFile, 'utf8'));
    }
  } catch {}
}

try {
  announcementsList = await getAllAnnouncements(50);
} catch {}

let universityRequestsList: UniversityRequest[] = [];
try {
  universityRequestsList = await getAllUniversityRequests();
} catch {}
const pendingUniRequestsCount = universityRequestsList.filter((r) => r.status === 'pending').length;

const STORAGE_BUDGET_BYTES = 20 * 1024 * 1024 * 1024; // 20 GB Budget
const storageUsedMB = (totalStoredBytes / (1024 * 1024)).toFixed(2);
const storagePercent = ((totalStoredBytes / STORAGE_BUDGET_BYTES) * 100).toFixed(2);
const isStorageWarning = parseFloat(storagePercent) >= 80;

function formatBytes(bytes: number) {
  if (!bytes) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
}
---

<Layout
  title="Administrator Control Center | StuddyBuddy"
  description="Administrative portal for StuddyBuddy. Manage resources, users, database records, and system security."
  noindex={true}
>
  <Header slot="header" user={user} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14 space-y-10">
    
    <!-- Top Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-slate-200/80 dark:border-slate-800 gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
            {user.role.toUpperCase()} PORTAL
          </span>
          <span class="text-xs text-slate-400">•</span>
          <span class="text-xs text-slate-500 font-medium">Logged in as: <strong class="text-slate-800 dark:text-slate-200">{user.email}</strong></span>
        </div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Admin Dashboard & Control Center
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">
          Authorized personnel only. Public student access is strictly restricted.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <a
          href="/database"
          class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-sm flex items-center gap-1.5 transition-all hover:scale-105"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
          </svg>
          <span>Cloud Database Viewer →</span>
        </a>
        <a
          href="/dashboard"
          class="px-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-semibold"
        >
          ← Student Dashboard
        </a>
      </div>
    </div>

    <!-- Live System Status Badges -->
    <div class="flex flex-wrap items-center gap-2.5 text-xs">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Firebase Auth: Live
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 font-semibold">
        <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
        Firestore: Connected
      </span>
      <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl font-semibold border ${
        mongoConnected 
          ? 'bg-emerald-50 dark:bg-emerald-950/60 border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300' 
          : 'bg-amber-50 dark:bg-amber-950/60 border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-300'
      }`}>
        <span class={`w-2 h-2 rounded-full ${mongoConnected ? 'bg-emerald-500' : 'bg-amber-500'}`}></span>
        Database: {mongoConnected ? 'MongoDB Atlas' : 'Local File Store (Active)'}
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-purple-50 dark:bg-purple-950/60 border border-purple-200 dark:border-purple-800 text-purple-700 dark:text-purple-300 font-semibold">
        Storage Engine: Local + Cloudflare R2 Ready
      </span>
    </div>

    <!-- Metrics Cards Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Users</span>
        <p class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">{totalUsersCount}</p>
        <span class="text-[11px] text-slate-500 mt-1 block">Registered Students</span>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Campus Requests</span>
        <p class="text-3xl font-extrabold text-sky-600 dark:text-sky-400 mt-1">
          {pendingUniRequestsCount} <span class="text-xs text-slate-400 font-normal">({universityRequestsList.length} total)</span>
        </p>
        <span class="text-[11px] text-slate-500 mt-1 block">Campuses Pending Review</span>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Moderation Queue</span>
        <p class="text-3xl font-extrabold text-amber-500 mt-1">{pendingCount}</p>
        <span class="text-[11px] text-slate-500 mt-1 block">Documents Awaiting Approval</span>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Live Documents</span>
        <p class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1">{approvedCount}</p>
        <span class="text-[11px] text-slate-500 mt-1 block">Accessible to Students</span>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm col-span-2 sm:col-span-1">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Storage Used</span>
        <p class="text-3xl font-extrabold text-indigo-600 dark:text-indigo-400 mt-1">{storageUsedMB} <span class="text-lg">MB</span></p>
        <span class="text-[11px] text-slate-500 mt-1 block">Of 20 GB budget</span>
      </div>
    </div>

    <!-- Storage Quota Status Bar -->
    <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-slate-900 dark:text-white">Object Storage Capacity & Budget</h2>
          <p class="text-xs text-slate-500">20 GB Configurable Target Budget (Cloudflare R2 / S3)</p>
        </div>
        <span class={`text-xs font-bold px-3 py-1 rounded-full ${
          isStorageWarning ? 'bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300' : 'bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300'
        }`}>
          {storageUsedMB} MB / 20,480 MB ({storagePercent}%)
        </span>
      </div>

      <div class="w-full h-3 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
        <div
          class={`h-full rounded-full transition-all duration-500 ${isStorageWarning ? 'bg-rose-500' : 'bg-indigo-600'}`}
          style={`width: ${Math.min(100, Math.max(1, parseFloat(storagePercent)))}%`}
        ></div>
      </div>
    </div>

    <!-- SECTION: Universal Campus Broadcast & Notification Center -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400">
              Live Campus Broadcaster
            </span>
          </div>
          <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
            Universal Notification & Broadcast Center ({announcementsList.length})
          </h2>
          <p class="text-xs text-slate-500">
            Publish announcements sent instantly to ALL visitors — whether unauthenticated guests or logged-in students.
          </p>
        </div>
      </div>

      <!-- Broadcast Creation Form -->
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-5">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
          <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span>📢</span>
            <span>Create New Public Broadcast</span>
          </h3>
          <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800">
            Audience: Everyone (Guests + Registered Students)
          </span>
        </div>

        <form id="broadcast-form" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="md:col-span-2 space-y-1.5">
              <label for="notif-input-title" class="text-xs font-bold text-slate-700 dark:text-slate-300">
                Notification Headline / Title *
              </label>
              <input
                id="notif-input-title"
                type="text"
                required
                placeholder="e.g. End-Sem 2026 Examination Schedule & Formula Sheets Published"
                class="w-full px-3.5 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium"
              />
            </div>

            <div class="space-y-1.5">
              <label for="notif-input-priority" class="text-xs font-bold text-slate-700 dark:text-slate-300">
                Priority Level
              </label>
              <select
                id="notif-input-priority"
                class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium"
              >
                <option value="normal">Normal (Notice / General)</option>
                <option value="high">Important (Amber Highlight)</option>
                <option value="urgent">Urgent (Red Alert Badge)</option>
              </select>
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="notif-input-content" class="text-xs font-bold text-slate-700 dark:text-slate-300">
              Broadcast Message Content *
            </label>
            <textarea
              id="notif-input-content"
              rows="3"
              required
              placeholder="Enter full details of the announcement that all students and guests should see when clicking the notification bell icon..."
              class="w-full px-3.5 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 font-normal leading-relaxed"
            ></textarea>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="notif-input-cta-label" class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                Action Button Label (Optional)
              </label>
              <input
                id="notif-input-cta-label"
                type="text"
                placeholder="e.g. View Study Materials"
                class="w-full px-3.5 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium"
              />
            </div>

            <div class="space-y-1.5">
              <label for="notif-input-cta-url" class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                Action URL / Destination (Optional)
              </label>
              <input
                id="notif-input-cta-url"
                type="text"
                placeholder="e.g. /resources or /university/parul-university"
                class="w-full px-3.5 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium"
              />
            </div>
          </div>

          <div class="flex items-center justify-between pt-2">
            <p class="text-[11px] text-slate-400">
              ⚡ Will instantly trigger the notification bell badge across all student & guest browsers.
            </p>
            <button
              id="notif-submit-btn"
              type="submit"
              class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-md shadow-indigo-600/20 hover:scale-[1.02] transition-all flex items-center gap-1.5 cursor-pointer"
            >
              <span>🚀 Send Broadcast Notification Now</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Active Broadcasts Table -->
      <div class="rounded-2xl border border-slate-200/90 dark:border-slate-800 overflow-hidden bg-white dark:bg-slate-900 shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 font-semibold uppercase tracking-wider border-b border-slate-200 dark:border-slate-800">
              <tr>
                <th class="p-4">Notification Title</th>
                <th class="p-4">Priority</th>
                <th class="p-4">Target Audience</th>
                <th class="p-4">Published At</th>
                <th class="p-4">Author</th>
                <th class="p-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              {announcementsList.length > 0 ? (
                announcementsList.map((ann) => (
                  <tr id={`announcement-row-${ann._id}`} class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition-colors">
                    <td class="p-4">
                      <span class="font-bold text-slate-900 dark:text-white block text-sm">{ann.title}</span>
                      <span class="text-[11px] text-slate-400 line-clamp-1 mt-0.5">{ann.content}</span>
                      {ann.callToActionUrl && (
                        <span class="inline-block text-[10px] text-indigo-600 dark:text-indigo-400 font-semibold mt-1">
                          Link: {ann.callToActionUrl}
                        </span>
                      )}
                    </td>
                    <td class="p-4">
                      <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
                        ann.priority === 'urgent'
                          ? 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300'
                          : ann.priority === 'high'
                          ? 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300'
                          : 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300'
                      }`}>
                        {ann.priority || 'NORMAL'}
                      </span>
                    </td>
                    <td class="p-4 text-slate-600 dark:text-slate-400">
                      <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-semibold text-[11px]">
                        All (Guests + Users)
                      </span>
                    </td>
                    <td class="p-4 text-slate-400 font-mono text-[11px]">
                      {ann.createdAt ? new Date(ann.createdAt).toLocaleString() : 'Just now'}
                    </td>
                    <td class="p-4 text-slate-600 dark:text-slate-400 font-medium">
                      {ann.createdByName || 'Admin'}
                    </td>
                    <td class="p-4 text-right">
                      <button
                        onclick={`deleteAnnouncementAdmin('${ann._id}', '${ann.title.replace(/'/g, "\\'")}')`}
                        class="px-2.5 py-1.5 rounded-lg bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 hover:bg-rose-600 hover:text-white font-bold text-xs transition-colors cursor-pointer"
                        title="Delete announcement"
                      >
                        🗑️ Delete
                      </button>
                    </td>
                  </tr>
                ))
              ) : (
                <tr>
                  <td colspan="6" class="p-8 text-center text-xs text-slate-400">
                    No broadcasts published yet. Use the form above to broadcast your first campus notification!
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- SECTION: University & College Creation Requests -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="w-2.5 h-2.5 rounded-full bg-sky-500 animate-pulse"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">
              Campus Governance
            </span>
          </div>
          <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            <span>🏛️ University & College Creation Requests</span>
            <span class="text-sm font-semibold px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300">
              {pendingUniRequestsCount} Pending
            </span>
          </h2>
          <p class="text-xs text-slate-500">
            Review student requests to add new campuses. Approving makes the university live site-wide and enables departmental setup.
          </p>
        </div>

        <a
          href="/add-university"
          target="_self"
          class="px-3.5 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs shadow-sm flex items-center gap-1.5 self-start sm:self-auto transition-transform hover:scale-105"
        >
          <span>+ Add University Directly</span>
        </a>
      </div>

      {universityRequestsList.length > 0 ? (
        <div class="rounded-2xl border border-slate-200/90 dark:border-slate-800 overflow-hidden bg-white dark:bg-slate-900 shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 font-semibold uppercase tracking-wider border-b border-slate-200 dark:border-slate-800">
                <tr>
