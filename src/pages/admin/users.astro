---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../server/db/mongo';
import { readLocalUsers } from '../../server/auth/userStore';
import type { User } from '../../types';

let usersList: User[] = [];
let totalUsersCount = 0;

try {
  const db = await getDb();
  usersList = await db
    .collection<User>('users')
    .find({})
    .sort({ createdAt: -1 })
    .limit(100)
    .toArray();
  totalUsersCount = await db.collection('users').countDocuments({});
} catch {
  usersList = readLocalUsers();
  totalUsersCount = usersList.length;
}
---

<AdminLayout
  title="User Directory & Permissions | Admin Control Center"
  activeNav="users"
>
  <div class="space-y-8">
    
    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 dark:border-slate-800 gap-3">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Account Governance & Security
          </span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2.5">
          <span>👥 User Directory & Permission Control</span>
          <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300">
            {totalUsersCount} Registered Accounts
          </span>
        </h1>
        <p class="text-xs text-slate-500 mt-1 max-w-2xl">
          Manage platform accounts, review verification status, assign administrative privileges, and apply security restrictions (account suspension, upload blocking).
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold text-xs">
          Total Users: {totalUsersCount}
        </span>
      </div>
    </div>

    <!-- Users Table -->
    <div class="rounded-2xl border border-slate-200/90 dark:border-slate-800 overflow-hidden bg-white dark:bg-slate-900 shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-500 font-semibold uppercase tracking-wider border-b border-slate-200 dark:border-slate-800">
            <tr>
              <th class="p-4">User</th>
              <th class="p-4">Role</th>
              <th class="p-4">Status</th>
              <th class="p-4">Registered</th>
              <th class="p-4 text-right">Administrative Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {usersList.map((u) => (
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition-colors">
                <td class="p-4">
                  <span class="font-bold text-slate-900 dark:text-white block text-sm">{u.displayName}</span>
                  <span class="text-slate-400 font-mono text-[11px]">{u.email}</span>
                </td>
                <td class="p-4 font-semibold uppercase text-[10px]">
                  <span class={`px-2 py-0.5 rounded ${u.role === 'owner' ? 'bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300 font-bold' : u.role === 'admin' ? 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300 font-bold' : 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300'}`}>
                    {u.role}
                  </span>
                </td>
                <td class="p-4">
                  <span class={`px-2 py-0.5 rounded text-[10px] font-bold ${u.status === 'suspended' ? 'bg-rose-100 text-rose-800' : 'bg-emerald-100 text-emerald-800'}`}>
                    {u.status?.toUpperCase() || 'ACTIVE'}
                  </span>
                </td>
                <td class="p-4 text-slate-400">
                  {new Date(u.createdAt).toLocaleDateString()}
                </td>
                <td class="p-4 text-right space-x-1.5 whitespace-nowrap">
                  {u.role !== 'owner' ? (
                    <>
                      {u.status === 'suspended' ? (
                        <button
                          onclick={`manageUser('${u._id}', 'restore')`}
                          class="px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 hover:bg-emerald-200 font-semibold text-[11px] cursor-pointer"
                        >
                          Restore Account
                        </button>
                      ) : (
                        <button
                          onclick={`manageUser('${u._id}', 'suspend')`}
                          class="px-2.5 py-1 rounded-lg bg-rose-100 text-rose-800 hover:bg-rose-200 font-semibold text-[11px] cursor-pointer"
                        >
                          Suspend
                        </button>
                      )}
                      {u.restrictions?.uploadsBlocked ? (
                        <button
                          onclick={`manageUser('${u._id}', 'unrestrict_uploads')`}
                          class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 font-semibold text-[11px] cursor-pointer"
                        >
                          Unblock Uploads
                        </button>
                      ) : (
                        <button
                          onclick={`manageUser('${u._id}', 'restrict_uploads')`}
                          class="px-2.5 py-1 rounded-lg bg-amber-100 text-amber-800 hover:bg-amber-200 font-semibold text-[11px] cursor-pointer"
                        >
                          Block Uploads
                        </button>
                      )}
                    </>
                  ) : (
                    <span class="text-[11px] text-slate-400 italic">Protected (Owner)</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>

<script is:inline>
  async function manageUser(userId, action) {
    let reason = '';
    if (action === 'suspend' || action === 'restrict_uploads') {
      reason = prompt(`Enter reason for ${action}:`);
      if (reason === null) return;
    }

    try {
      const res = await fetch('/api/admin/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId, action, reason }),
      });

      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'User management action failed.');
      } else {
        alert('User updated successfully!');
        location.reload();
      }
    } catch (err) {
      alert('Network error.');
    }
  }
</script>

