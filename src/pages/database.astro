---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getDb } from '../server/db/mongo';
import { readFirestoreCollection } from '../lib/firebase';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?redirect=/database');
}
if (user.role !== 'admin' && user.role !== 'owner') {
  return Astro.redirect('/dashboard?error=unauthorized_database');
}

// Initial server-side read of resources collection
let initialResources: any[] = [];
let mongoConnected = false;

try {
  const db = await getDb();
  initialResources = await db.collection('resources').find({}).limit(10).toArray();
  mongoConnected = true;
} catch (err) {
  // If MongoDB is offline, read from Firestore
  try {
    initialResources = await readFirestoreCollection('resources', 10);
  } catch (fsErr) {
    initialResources = [];
  }
}
---

<Layout
  title="Database Explorer & Cloud Sync | StuddyBuddy"
  description="Inspect and read live database collections from MongoDB Atlas and Firebase Firestore."
>
  <Header slot="header" user={user} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16 space-y-8">
    
    <!-- Hero / Title -->
    <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-slate-200/80 dark:border-slate-800 gap-4">
      <div>
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
            </svg>
          </div>
          <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Database Reader & Cloud Sync
          </h1>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Live inspection and querying for Firebase Firestore (Project: <code class="font-mono text-indigo-600 dark:text-indigo-400">studdybuddy-49db8</code>) and MongoDB Atlas.
        </p>
      </div>

      <!-- Live Connection Badges -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Firebase Auth: Active
        </span>

        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 font-semibold">
          <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
          Firestore: Connected
        </span>

        <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl font-semibold border ${
          mongoConnected 
            ? 'bg-emerald-50 dark:bg-emerald-950/60 border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300' 
            : 'bg-amber-50 dark:bg-amber-950/60 border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-300'
        }`}>
          <span class={`w-2 h-2 rounded-full ${mongoConnected ? 'bg-emerald-500' : 'bg-amber-500'}`}></span>
          MongoDB: {mongoConnected ? 'Connected' : 'Local / Standby'}
        </span>
      </div>
    </div>

    <!-- Collection Query Toolbar -->
    <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Quick Collections:</span>
          <button data-col="resources" class="col-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white shadow-sm transition-all">
            resources
          </button>
          <button data-col="users" class="col-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
            users
          </button>
          <button data-col="catalogSuggestions" class="col-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
            catalogSuggestions
          </button>
          <button data-col="analyticsEvents" class="col-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
            analyticsEvents
          </button>
          <button data-col="announcements" class="col-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
            announcements
          </button>
        </div>

        <div class="flex items-center gap-2">
          <input
            id="custom-col-input"
            type="text"
            placeholder="Custom collection name..."
            class="px-3 py-1.5 text-xs rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
          <button
            id="read-btn"
            type="button"
            class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-600/25 transition-all flex items-center gap-1.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span id="read-btn-text">Read Database</span>
          </button>
        </div>
      </div>

      <!-- Status notification bar -->
      <div id="status-bar" class="p-3 rounded-xl bg-slate-100 dark:bg-slate-800/80 text-xs text-slate-600 dark:text-slate-300 flex items-center justify-between">
        <span>Active Target: <strong id="current-col-label" class="text-indigo-600 dark:text-indigo-400">resources</strong></span>
        <span id="doc-count-badge" class="font-semibold text-slate-700 dark:text-slate-200">Loaded: {initialResources.length} documents</span>
      </div>
    </div>

    <!-- Database Results Display Area -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>Collection Documents</span>
          <span id="count-pill" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-100 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300">
            {initialResources.length}
          </span>
        </h2>

        <div class="flex items-center gap-2">
          <button
            id="copy-json-btn"
            type="button"
            class="px-3 py-1.5 text-xs font-semibold rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors"
          >
            Copy JSON
          </button>
        </div>
      </div>

      <!-- JSON Viewer / Documents Cards -->
      <div id="results-container" class="space-y-3">
        {initialResources.length > 0 ? (
          initialResources.map((doc, idx) => (
            <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400">
                  #{idx + 1} — ID: {doc._id || doc.id || 'N/A'}
                </span>
                <span class="text-[10px] text-slate-400 uppercase font-bold tracking-wider">
                  {doc.category || doc.role || doc.entityType || 'Document'}
                </span>
              </div>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">
                {doc.title || doc.displayName || doc.name || doc.proposedName || 'Untitled Record'}
              </h3>
              <pre class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950/80 text-[11px] font-mono text-slate-700 dark:text-slate-300 overflow-x-auto max-h-48 border border-slate-200/50 dark:border-slate-800/50">
                {JSON.stringify(doc, null, 2)}
              </pre>
            </div>
          ))
        ) : (
          <div class="p-12 text-center bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 space-y-3">
            <div class="w-12 h-12 mx-auto rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
              </svg>
            </div>
            <p class="text-sm font-medium text-slate-600 dark:text-slate-300">No documents found in this collection yet.</p>
            <p class="text-xs text-slate-400">Click "Read Database" above or upload a past paper to populate the database.</p>
          </div>
        )}
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<script>
  let currentCollection = 'resources';
  let loadedDocs: any[] = [];

  const readBtn = document.getElementById('read-btn') as HTMLButtonElement;
  const readBtnText = document.getElementById('read-btn-text') as HTMLSpanElement;
  const customColInput = document.getElementById('custom-col-input') as HTMLInputElement;
  const colButtons = document.querySelectorAll('.col-btn');
  const resultsContainer = document.getElementById('results-container') as HTMLDivElement;
  const currentColLabel = document.getElementById('current-col-label') as HTMLElement;
  const docCountBadge = document.getElementById('doc-count-badge') as HTMLElement;
  const countPill = document.getElementById('count-pill') as HTMLElement;
  const copyJsonBtn = document.getElementById('copy-json-btn') as HTMLButtonElement;

  // Handle quick collection selection
  colButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      colButtons.forEach((b) => {
        b.classList.remove('bg-indigo-600', 'text-white');
        b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
      });
      btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
      btn.classList.add('bg-indigo-600', 'text-white');

      currentCollection = btn.getAttribute('data-col') || 'resources';
      if (customColInput) customColInput.value = '';
      fetchAndRenderCollection(currentCollection);
    });
  });

  // Handle manual input & read
  readBtn?.addEventListener('click', () => {
    if (customColInput && customColInput.value.trim()) {
      currentCollection = customColInput.value.trim();
    }
    fetchAndRenderCollection(currentCollection);
  });

  copyJsonBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(JSON.stringify(loadedDocs, null, 2));
    const origText = copyJsonBtn.innerText;
    copyJsonBtn.innerText = 'Copied!';
    setTimeout(() => {
      copyJsonBtn.innerText = origText;
    }, 1500);
  });

  async function fetchAndRenderCollection(colName: string) {
    if (currentColLabel) currentColLabel.innerText = colName;
    if (readBtnText) readBtnText.innerText = 'Reading...';
    readBtn.disabled = true;

    try {
      const res = await fetch(`/api/firebase/database?collection=${encodeURIComponent(colName)}&limit=50`);
      const result = await res.json();

      loadedDocs = result.data || [];
      const count = loadedDocs.length;

      if (docCountBadge) docCountBadge.innerText = `Loaded: ${count} documents`;
      if (countPill) countPill.innerText = count.toString();

      if (count === 0) {
        resultsContainer.innerHTML = `
          <div class="p-12 text-center bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 space-y-3">
            <p class="text-sm font-semibold text-slate-700 dark:text-slate-300">No documents in collection "${colName}".</p>
            <p class="text-xs text-slate-400">The collection is currently empty in Firestore and database.</p>
          </div>
        `;
      } else {
        resultsContainer.innerHTML = loadedDocs.map((doc, idx) => `
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400">
                #${idx + 1} — ID: ${doc._id || doc.id || 'N/A'}
              </span>
              <span class="text-[10px] text-slate-400 uppercase font-bold tracking-wider">
                ${doc.category || doc.role || doc.entityType || 'Document'}
              </span>
            </div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">
              ${doc.title || doc.displayName || doc.name || doc.proposedName || 'Untitled Record'}
            </h3>
            <pre class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950/80 text-[11px] font-mono text-slate-700 dark:text-slate-300 overflow-x-auto max-h-48 border border-slate-200/50 dark:border-slate-800/50">
${escapeHtml(JSON.stringify(doc, null, 2))}
            </pre>
          </div>
        `).join('');
      }
    } catch (err: any) {
      resultsContainer.innerHTML = `
        <div class="p-6 rounded-2xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300 text-xs">
          Failed to read database collection "${colName}": ${err?.message || 'Network error'}
        </div>
      `;
    } finally {
      if (readBtnText) readBtnText.innerText = 'Read Database';
      readBtn.disabled = false;
    }
  }

  function escapeHtml(str: string) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
</script>
